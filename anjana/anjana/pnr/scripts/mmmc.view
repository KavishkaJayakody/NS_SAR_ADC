set PDK /home/user23/Sky130_cadance_pdk/sky130_scl_9T_0.1.1/sky130_scl_9T

create_library_set -name lib_tt \
  -timing [list $PDK/lib/sky130_tt_1.8_25_nldm.lib]

create_rc_corner -name rc_typ \
  -qx_tech_file /home/user23/Sky130_cadance_pdk/sky130_release_0.1.0/quantus/extraction/typical/qrcTechFile

create_constraint_mode -name cm -sdc_files [list ./gate_driver.sdc]

create_delay_corner -name dc_tt -library_set lib_tt -rc_corner rc_typ

create_analysis_view -name av_tt -constraint_mode cm -delay_corner dc_tt
set_analysis_view -setup {av_tt} -hold {av_tt}
