    ANGLE ncm_not_rect -ne 45 _EPTMPL262359;
    ANGLE x.3.ncm:_EPTMPL262359 -ltgt 0 90;
}

RULE x.3.inductor {
    CAPTION "inductor has non-45 degree edge ";
    ANGLE inductor_not_rect -ne 45 _EPTMPL262361;
    ANGLE x.3.inductor:_EPTMPL262361 -ltgt 0 90;
}

RULE x.3.hvtr {
    CAPTION "hvtr has non-45 degree edge ";
    ANGLE hvtr_not_rect -ne 45 _EPTMPL262363;
    ANGLE x.3.hvtr:_EPTMPL262363 -ltgt 0 90;
}

RULE x.5.nwell {
    CAPTION 'All "pin" polygons must be within the 'drawing' polygons of the layer - nwell';
    NOT nwell_pin nwell;
}

RULE x.5.diff {
    CAPTION 'All "pin" polygons must be within the 'drawing' polygons of the layer - diff';
    NOT diff_pin diff_dg;
}

RULE x.5.poly {
    CAPTION 'All "pin" polygons must be within the 'drawing' polygons of the layer - poly';
    NOT poly_pin poly_dg;
}

RULE x.5.li {
    CAPTION 'All "pin" polygons must be within the 'drawing' polygons of the layer - LI';
    NOT li1_pin li_dg;
}

RULE x.5.m1 {
    CAPTION 'All "pin" polygons must be within the 'drawing' polygons of the layer - met1';
    NOT met1_pin m1_dg;
}

RULE x.5.m2 {
    CAPTION 'All "pin" polygons must be within the 'drawing' polygons of the layer - met2';
    NOT met2_pin m2_dg;
}

RULE x.5.m3 {
    CAPTION 'All "pin" polygons must be within the 'drawing' polygons of the layer - met3';
    NOT met3_pin m3_dg;
}

RULE x.5.m4 {
    CAPTION 'All "pin" polygons must be within the 'drawing' polygons of the layer - met4';
    NOT met4_pin m4_dg;
}

RULE x.5.m5 {
    CAPTION 'All "pin" polygons must be within the 'drawing' polygons of the layer - met5';
    NOT met5_pin m5_dg;
}

RULE x.5.pad {
    CAPTION 'All "pin" polygons must be within the 'drawing' polygons of the layer - pad';
    NOT pad_pin pad;
}

RULE x.10.diff {
    CAPTION "res purpose layer for diff cannot overlap licon";
    AND diff_res licon;
}

RULE x.10.poly {
    CAPTION "res purpose layer for poly cannot overlap licon";
    AND poly_res licon;
}
LAYER_DEF quadrant1 9991;
LAYER_DEF quadrant2 9992;
LAYER_DEF quadrant3 9993;
LAYER_DEF quadrant4 9994;
CREATE_POLYGON 0 0 0.005 0.005 "quadrant1";
CREATE_POLYGON -0.005 0 0 0.005 "quadrant2";
CREATE_POLYGON -0.005 -0.005 0 0 "quadrant3";
CREATE_POLYGON 0 -0.005 0.005 0 "quadrant4";
EXTENT -layer SEALID -outputlayer SEALID_extent;
SELECT -enclose SEALID_extent quadrant1 -outputlayer SEALID_quadrant1;
SELECT -touch SEALID_quadrant1 quadrant2 -outputlayer SEALID_quadrant12;
SELECT -outside SEALID_quadrant12 quadrant3 -outputlayer SEALID_quadrant123;
SELECT -touch SEALID_quadrant123 quadrant4 -outputlayer SEALID_quadrant1234;

RULE x.19 {
    CAPTION "Lower left corner of the Seal Ring should be at origin (0,0)";
    NOT SEALID_extent SEALID_quadrant1234;
}

RULE x.23c.poly {
    CAPTION "areaid:seal (Seal Ring) must not overlap poly";
    AND SEALID poly;
}

RULE x.23c.li1 {
    CAPTION "areaid:seal (Seal Ring) must not overlap li1";
    AND SEALID li1;
}

RULE x.23c.m1 {
    CAPTION "areaid:seal (Seal Ring) must not overlap met1";
    AND SEALID met1;
}

RULE x.23c.m2 {
    CAPTION "areaid:seal (Seal Ring) must not overlap met2";
    AND SEALID met2;
}

RULE x.23c.m3 {
    CAPTION "areaid:seal (Seal Ring) must not overlap met3";
    AND SEALID met3;
}

RULE x.23c.m4 {
    CAPTION "areaid:seal (Seal Ring) must not overlap met4";
    AND SEALID met4;
}

RULE x.23c.m5 {
    CAPTION "areaid:seal (Seal Ring) must not overlap met5";
    AND SEALID met5;
}

RULE CDRW.x.8 {
    CAPTION "CDRW: WARNING: Use of areaid.ce layer (memory core ID layer) must be approved by SkyWater Technology";
    CAPTION "CDRW: WARNING: Some rules apply only to areas outside of areid.ce and a core rule may not exist ";
    EXTENT_DRAWN areaid.ce;
}

RULE CDRW.x.fuse {
    CAPTION "CDRW: WARNING: The met4 fuse layer (GDS 71:17) is no longer supported";
    COPY met4_fuse;
}

RULE x.moduleCut {
    CAPTION "WARNING: Use of areaid.mt (moduleCut) layer (GDS 81:10) is for SkyWater Technology only";
    EXTENT_DRAWN areaid.mt;
}

RULE CDRW.x.photo {
    CAPTION "CDRW: WARNING: Use of areaid:photo layer (GDS 81:81) is prohibited";
    COPY areaid.po;
}

RULE x.prBndry {
    CAPTION "WARNING: Use of prBoundary layer (GDS 235:4) is prohibited";
    COPY prBndry;
}

RULE x.pwell {
    CAPTION "WARNING: pwell must connect by ptap at least once";
    SELECT -enclose -not pwell ptap;
    SELECT -enclose -not localSub ptap;
}

RULE CDRW.x.RDL {
    CAPTION "CDRW: WARNING: Use of the RDL layer (GDS 74:20) is prohibited";
    COPY target;
}

RULE CDRW.x.target {
    CAPTION "CDRW: WARNING: Use of the fuse target layer (GDS 76:44) is prohibited";
    COPY target;
}

RULE CDRW.x.tunm {
    CAPTION "CDRW: WARNING: Use of the tunm layer (GDS 80:20) is prohibited";
    COPY tunm;
}

RULE CDRW.dnwell.2 {
    CAPTION "CDRW: Min width of deep nwell: 3. um";
    INTE dnwell -lt 3 -output region;
}
SELECT -outside dnwell uhvi -outputlayer dnwell_lvi;
STAMP dnwell_lvi dnwell dnwell_lv;
AND dnwell uhvi -outputlayer dnwell_uhvi;

RULE CDRW.dnwell.3 {
    CAPTION "CDRW: Min spacing/notch between deep nwell (rule exempt inside UHVI): 6.3 um";
    EXTE dnwell_lv -lt 6.3 -abut -lt 90 -single_point -output region;
}

RULE dnwell.3a {
    CAPTION "Min spacing of dwnell in v20 on same net: 2.5";
    EXTE dnwell_uhvi -lt 12 -abut -lt 90 -single_point -output region -connected;
}

RULE dnwell.3d {
    CAPTION "Min spacing of dwnell in v20 not on same net: 12.0";
    EXTE dnwell_uhvi -lt 12 -abut -lt 90 -single_point -output region -not_connected;
}

RULE dnwell.3b {
    CAPTION "Min spacing of dnwell in uhvi to dnwell outside uhvi: 12.0";
    EXTE dnwell_uhvi dnwell_lv -lt 12 -abut -lt 90 -single_point -output region -exclude_false_notch;
Warning: EXTE: Skip -exclude_false_notch option at line 33 in file /home/aed/libs/Sky130_cadance_pdk/sky130_release_0.1.0/Sky130_DRC/Include/dnwell.drc.pvl
}

RULE dnwell.3c {
    CAPTION "Min spacing of dnwell in v20 to nwell outside v20: 9.5";
    EXTE dnwell_uhvi dnwell_lv -lt 9.5 -abut -lt 90 -single_point -output region;
}

RULE dnwell.4 {
    CAPTION "Dnwell can not overlap pnp";
    AND dnwell pnp;
}

RULE dnwell.5 {
    CAPTION P+ Diff can not straddle dnwell";
    SELECT -cut pdiff dnwell;
}

RULE dnwell.7 {
    CAPTION "Dnwell can not straddle areaid:substratecut";
    SELECT -cut dnwell localSub;
}

RULE nwell.1 {
    CAPTION "Width of nwell: 0.84 um";
    INTE nwell -lt 0.84 -output region;
}

RULE CDR.nwell.2a.lv {
    CAPTION "CDR: Min space/notch between two LV n-wells: 1.27 um";
    CAPTION "  Manual merge wells if less than minimum ";
    EXTE nwell_lv -lt 1.27 -notch also -single_point -output region;
}

RULE nwell.2a.lv_hv {
    CAPTION "Min space of LV_nwell to HV_nwell: 1.27";
    EXTE nwell_lv nwell_hv -lt 1.27 -abut -lt 90 -single_point -output region;
}

RULE nwell.2a.lv_vhv {
    CAPTION "Min space of LV_nwell to VHV_nwell: 2.0";
    EXTE nwell_lv nwell_vhv -lt 2 -abut -lt 90 -single_point -output region;
}

RULE nwell.2a.lv_uhv {
    CAPTION "Min space of LV_nwell to UHV_nwell: 2.5";
    EXTE nwell_lv nwell_uhv -lt 2.5 -abut -lt 90 -single_point -output region;
}

RULE nwell.4 {
    CAPTION "All n-wells will contain metal-contacted tap";
    CAPTION "(rule checks only for licon on tap).";
    CAPTION "Rule exempted from high voltage cells inside UHVI";
    CAPTION "NOTE: exceptions have NOT been considered, there may be false errors";
    SELECT -enclose -not nwell tap_licon;
}

RULE nwell.5 {
    CAPTION "Deep nwell must be enclosed by nwell by atleast: 0.40 um";
    CAPTION "Exempted inside UHVI (layer v20) or areaid.lw";
    CAPTION "Nwells can merge over deep nwell if spacing too small";
    CAPTION "NOTE: exceptions have NOT been considered, there may be false errors";
    INSIDE_CELL -not "nwell" "*_tech_CD_top" -outputlayer "nwell.5_notCD";
    NOT dnwell uhvi -outputlayer dnwell.5;
    ENC dnwell.5 nwell.5_notCD -lt 0.4 -output region;
}

RULE nwell.6 {
    CAPTION "Min enclosure of nwell hole by deep nwell outside UHVI: 1.03 um";
    CAPTION "shapes in cell "*_tech_CD_top" exempted";
    INSIDE_CELL -not "nwell" "*_tech_CD_top" -outputlayer "nwell.6_a";
    SELECT -outside nwell.6_a uhvi -outputlayer nwell.6_b;
    HOLES nwell.6_b -outputlayer nwell.6_c;
    ENC nwell.6_c dnwell -lt 1.03 -output region;
}

RULE nwell.ntap {
    CAPTION "nwell must have at least one ntap";
    SELECT -enclose -not nwell ntap;
}

RULE hvtp.1 {
    CAPTION "CDR: Min width of hvtp: 0.38 um";
    INTE hvtp -lt 0.38 -single_point -output region;
}

RULE hvtp.2 {
    CAPTION "CDR: Min spacing of hvtp to hvtp: 0.38 um";
    EXTE hvtp -lt 0.38 -single_point -output region;
}

RULE hvtp.3 {
    CAPTION "Min enclosure of pfet outside of areaid.ce by hvtp: 0.18 um";
    SELECT -outside pfet areaid.ce _EPTMPL262428;
    ENC hvtp.3:_EPTMPL262428 hvtp -lt 0.18 -output region;
}

RULE hvtp.4 {
    CAPTION "Min spacing between pfet and hvtp: 0.18 um";
    EXTE pfet hvtp -lt 0.18 -single_point -output region;
}

RULE hvtp.5 {
    CAPTION "Min area of hvtp: 0.265 sq um";
    AREA hvtp -lt 0.265;
}

RULE hvtp.6 {
    CAPTION "Min area of hvtp holes: 0.265 sq um";
    HOLES hvtp -outputlayer hvtp.6_a;
    AREA hvtp.6_a -lt 0.265;
}

RULE hvtr.1 {
    CAPTION "CDR: Min width of hvtr: 0.38 um";
    INTE hvtr -lt 0.38 -single_point -output region;
}

RULE hvtr.2 {
    CAPTION "CDR: Min spacing of hvtp to hvtr: 0.38 um";
    EXTE hvtp hvtr -lt 0.38 -single_point -output region;
}

RULE hvtr.3 {
    CAPTION "Min enclosure of pfet by hvtr: 0.18 um";
    ENC pfet hvtr -lt 0.18 -output region;
}

RULE CDR.lvtn.1a {
    CAPTION "CDR: Min width of lvtn: 0.38 um";
    INTE lvtn -lt 0.38 -single_point -output region;
}

RULE CDR.lvtn.2 {
    CAPTION "CDR: Min spacing lvtn to lvtn: 0.38 um";
    EXTE lvtn -lt 0.38 -single_point -output region;
}

RULE lvtn.3a {
    CAPTION "Min spacing of lvtn to gate. Rule exempted inside UHVI: 0.18 um";
    NOT lvtn uhvi -outputlayer lvtn.3a_exempt;
    EXTE lvtn.3a_exempt -lt 0.18 -single_point -output region;
}

RULE lvtn.3b {
    CAPTION "Min spacing of lvtn to pfet along the S/D direction: 0.19 um";
    EDGE_BOOLEAN -coincident_only -outside gate pdiff -outputlayer lvtn.3b_a;
    EXTE lvtn lvtn.3b_a -lt 0.19 -single_point -output region;
}

RULE lvtn.4b {
    CAPTION "Min enclosure of gate by lvtn. Rule exempted inside UHVI: 0.18 um";
    NOT lvtn uhvi -outputlayer lvtn.3a_exempt;
    ENC gate lvtn -lt 0.18 -abut -lt 90 -output region;
}

RULE lvtn.9 {
    CAPTION "Min spacing, no overlap, between lvtn and hvtp: 0.38 um";
    EXTE lvtn hvtp -lt 0.38 -overlap -single_point -output region;
}

RULE lvtn.10 {
    CAPTION "Min enclosure of lvtn by (nwell not overlapping Var_channel) (exclude coincident edges): 0.38 um";
    SELECT -cut -not nwell Var_channel -outputlayer lvtn.10_a;
    ENC lvtn lvtn.10_a -lt 0.38 -output region;
}

RULE lvtn.12 {
    CAPTION "Min spacing between lvtn and (nwell inside areaid.ce): 0.38 um";
    SELECT -inside nwell areaid.ce -outputlayer lvtn.12_a;
    EXTE lvtn lvtn.12_a -lt 0.38 -single_point -output region;
}

RULE lvtn.13 {
    CAPTION "Min area of lvtn: 0.265 sq um";
    AREA lvtn -lt 0.265;
}

RULE lvtn.14 {
    CAPTION "Min area of lvtn holes: 0.265 sq um";
    HOLES lvtn -outputlayer lvtn.14_a;
    AREA lvtn.14_a -lt 0.265;
}

RULE CDR.lvtn.15 {
    CAPTION "CDR: lvtn cannot straddle nwell";
    SELECT -cut lvtn nwell;
}

RULE CDR.ncm.1 {
    CAPTION "CDR: Min width of ncm: 0.38 um";
    INTE ncm -lt 0.38 -single_point -output region;
}

RULE CDR.ncm.2 {
    CAPTION "CDR: Min spacing of ncm: 0.38 um";
    CAPTION "Manual merge ncm if space is below minimum";
    EXTE ncm -lt 0.38 -single_point -output region;
}

RULE ncm.3 {
    CAPTION "Min enclosure of P+diff by Ncm: 0.18 um";
    ENC pdiff Ncm -lt 0.18 -output region;
}
NOT areaid.ed areaid.de _EPTMPL262457;
AND pdiff _EPTMPL262457 -outputlayer pdiff_edde;

RULE ncm.4 {
    CAPTION "Min enclosure of P+diff within (areaid:esd AndNot areaid:diode) by Ncm: 0.18 um";
    ENC pdiff_edde Ncm -lt 0.18 -output region;
}

RULE ncm.5 {
    CAPTION "Min space, no overlap, between ncm and (LVTN_gate) OR (diff containing lvtn): 0.23 um;
    SELECT -enclose diff lvtn -outputlayer ncm.5_a;
    OR LVTN_gate ncm.5_a -outputlayer ncm.5_b;
    EXTE ncm ncm.5_b -lt 0.23 -overlap -single_point -output region -outputlayer ncm.5_c;
    SELECT -touch ncm ncm.5_b -outputlayer ncm.5_touch;
    OR ncm.5_c ncm.5_touch;
}

RULE ncm.6 {
    CAPTION "Min space, no overlap, between ncm and nfet: 0.20 um";
    EXTE ncm nfet -lt 0.2 -overlap -single_point -output region -outputlayer ncm.6_a;
    SELECT -touch ncm nfet -outputlayer ncm.6_touch;
    OR ncm.6_a ncm.6_touch;
}

RULE ncm.7 {
    CAPTION "Min area of ncm: 0.265 sq um";
    AREA ncm -lt 0.265;
}

RULE ncm.8 {
    CAPTION "Min area of ncm Holes: 0.265 sq um";
    HOLES ncm -outputlayer ncm.8_a;
    AREA ncm.8_a -lt 0.265;
}
SELECT -inside diff_in areaid.ce -outputlayer diff_core;
SELECT -outside diff_in areaid.ce -outputlayer diff_notcore;
SELECT -cut diff_in areaid.ce -outputlayer diff_cut_core;
SELECT -inside gate areaid.ce -outputlayer gate_core;
NOT gate gate_core -outputlayer gate_notcore;
SELECT -inside gate_notcore areaid.sc -outputlayer gate_SC;
NOT gate_notcore gate_SC -outputlayer gate_not_SC;
SELECT -inside tap areaid.ce -outputlayer tap_core;
SELECT -outside tap areaid.ce -outputlayer tap_notcore;

RULE CDR.difftap.1 {
    CAPTION "CDR: Minimum width of diff or tap outside areaid.ce: 0.15 um";
    OR diff_notcore tap_notcore _EPTMPL262480;
    INTE CDR.difftap.1:_EPTMPL262480 -lt 0.15 -output region;
}

RULE CDR.difftap.1a {
    CAPTION "CDR: Minimum width of diff or tap inside areaid.ce: 0.14 um";
    OR diff_core tap_core _EPTMPL262482;
    INTE CDR.difftap.1a:_EPTMPL262482 -lt 0.14 -output region;
}

RULE CDR.difftap.1b {
    CAPTION "CDR: Minimum width of diff or tap crossing areaid.ce: 0.15 um";
    INTE diff_cut_core -lt 0.15 -abut -lt 90 -single_point -output region;
}

RULE difftap.2 {
    CAPTION "Min channel width (Diff And Poly) for FETs outside areaid.sc and outside areaid.ce : 0.42 um";
    NOT diff_notcore gate_not_SC -outputlayer difftap.2_b;
    EDGE_BOOLEAN -not -coincident_only gate_not_SC difftap.2_b -outputlayer difftap.2_c;
    INTE difftap.2_c -lt 0.42 -output region;
}

RULE difftap.2b {
    CAPTION "Min channel width (Diff and Poly) for FETs inside areaid.sc but outside areaid.ce : 0.36 um";
    NOT diff_notcore gate_SC -outputlayer difftap.2b_b;
    EDGE_BOOLEAN -not -coincident_only gate_SC difftap.2b_b -outputlayer difftap.2b_c;
    INTE difftap.2b_c -lt 0.36 -output region;
}

RULE difftap.2c {
    CAPTION "Min channel width in areaid.ce: 0.14 um";
    AND gate areaid.ce _EPTMPL262491;
    EDGE_BOOLEAN -coincident_only -inside difftap.2c:_EPTMPL262491 diff _EPTMPL262492;
    INTE difftap.2c:_EPTMPL262492 -lt 0.14 -abut -lt 90 -output region;
}

RULE difftap.4 {
    CAPTION "Min width of tap butting diffusion: 0.29 um";
    SELECT -touch tap diff_in -eq 1 -outputlayer difftap.4_a;
    INTE difftap.4_a -lt 0.29 -output region;
}

RULE difftap.5a {
    CAPTION "Min width of tap outside areaid.ce butting and between diffusion: 0.40 um";
    NOT tap areaid.ce _EPTMPL262496;
    EDGE_BOOLEAN -coincident_only -outside difftap.5a:_EPTMPL262496 diff _EPTMPL262497;
    INTE difftap.5a:_EPTMPL262497 -lt 0.4 -abut -lt 90 -output region;
}

RULE difftap.5b {
    CAPTION "Min width of tap inside areaid.ce butting and between diffusion: 0.38 um";
    AND tap areaid.ce _EPTMPL262499;
    EDGE_BOOLEAN -coincident_only -outside difftap.5b:_EPTMPL262499 diff _EPTMPL262500;
    INTE difftap.5b:_EPTMPL262500 -lt 0.38 -abut -lt 90 -output region;
}

RULE CDR.difftap.3 {
    CAPTION "CDR: Min spacing of diff to diff: 0.27 um";
    EXTE diff_in -lt 0.27 -notch also -output region;
}
EXTE nsdm diff_and_psdm -lt 0.13 -metric opposite -para ONLY -output region -outputlayer diff_nbutting;
EXTE psdm diff_and_nsdm -lt 0.13 -metric opposite -para ONLY -output region -outputlayer diff_pbutting;

RULE difftap.7 {
    CAPTION "Min spacing of diff/tap abutting edge to a non-coinciding diff or tap edge: 0.13 um";
    OR diff_nbutting diff_pbutting;
}
NOT diff_and_nsdm areaid.ce ndiff_notcore;
AND diff_and_nsdm areaid.ce ndiff_core;

RULE difftap.9 {
    CAPTION "Min spacing of (n+) diffusion to N-well outside UHVI: 0.34 um";
    NOT ndiff_notcore UHVI -outputlayer difftap.9_a;
    EXTE difftap.9_a nwell -lt 0.34 -overlap -single_point -output region;
}

RULE difftap.11 {
    CAPTION "Min spacing of (p+) tap to N-well. Rule exempted inside UHVI: 0.13 um";
    NOT ptap_actual UHVI -outputlayer difftap.11_a;
    EXTE difftap.11_a nwell -lt 0.13 -output region;
}

RULE difftap.8a {
    CAPTION "Min enclosure of (p+) diffusion by N-well: 0.18 um";
    CAPTION "Rule exempted inside: UHVI / areaid.ed (ESD) / areaid.ce (CORE) ";
    NOT pdiff_actual UHVI _EPTMPL262512;
    NOT difftap.8a:_EPTMPL262512 areaid.ed _EPTMPL262513;
    NOT difftap.8a:_EPTMPL262513 areaid.ce -outputlayer difftap.8_a;
    ENC difftap.8_a nwell -lt 0.18 -output region;
}

RULE difftap.8b {
    CAPTION "Min enclosure of (p+) diffusion in areaid.ce by N-well: 0.15 um";
    AND pdiff_actual areaid.ce -outputlayer difftap.8b_a;
    ENC difftap.8b_a nwell -lt 0.15 -output region;
}

RULE difftap.8c {
    CAPTION "Min enclosure of adjacent sides of (p+) diffusion in areaid.ce by N-well: 0.18 um";
    RECT_CHK pdiff_actual -orthogonal_only _EPTMPL262518;
    SELECT -inside difftap.8c:_EPTMPL262518 areaid.ce -outputlayer difftap.8c_a;
    RECT_ENC difftap.8c_a nwell -good 0.18 0 0.18 0;
}

RULE difftap.10a {
    CAPTION "Min enclosure of (n+) tap by N-well: 0.18 um";
    CAPTION "Rule exempted inside: UHVI / areaid.ed (ESD) / areaid.ce (CORE) ";
    NOT ntap_actual UHVI _EPTMPL262521;
    NOT difftap.10a:_EPTMPL262521 areaid.ed _EPTMPL262522;
    NOT difftap.10a:_EPTMPL262522 areaid.ce -outputlayer difftap.10_a;
    ENC difftap.10_a nwell -lt 0.18 -output region;
}

RULE difftap.10b {
    CAPTION "Min enclosure of (n+) tap in areaid.ce by N-well: 0.15 um";
    AND ntap_actual areaid.ce -outputlayer difftap.10b_a;
    ENC difftap.10b_a nwell -lt 0.15 -output region;
}

RULE difftap.6 {
    CAPTION "diff and tap are not allowed to extend beyond their abutting edge";
    EDGE_BOOLEAN -coincident_only diff tap -outputlayer difftap.6_a;
    EDGE_SELECT -coincident_only diff tap -outputlayer difftap.6_b;
    EDGE_BOOLEAN -coincident_only -not difftap.6_a difftap.6_b;
}

RULE CDR.tunm.1 {
    CAPTION "CDR: Min width of tunm: 0.41 um";
    INTE tunm -lt 0.41 -single_point -output region;
}

RULE CDR.tunm.2 {
    CAPTION "CDR: Min spacing/notch of tunm: 0.50 um";
    EXTE tunm -lt 0.5 -single_point -output region;
}

RULE tunm.3 {
    CAPTION "Extension of tunm beyond (poly and diff): 0.095 um";
    ENC tunm gate -lt 0.095 -single_point -output region;
}

RULE tunm.4 {
    CAPTION "Min spacing of tunm to (poly and diff) outside tunm: 0.095 um";
    SELECT -outside gate tunm -outputlayer tunm.4_a;
    EXTE tunm tunm.4_a -lt 0.095 -single_point -output region;
}

RULE tunm.5 {
    CAPTION "(poly and diff) may not straddle tunm";
    SELECT -cut gate tunm;
}

RULE tunm.6a {
    CAPTION "Tunm outside deep n-well is not allowed";
    NOT tunm dnwell;
}

RULE tunm.7 {
    CAPTION "Min tunm area: 0.672 sq um";
    AREA tunm -lt 0.672;
}

RULE tunm.8 {
    CAPTION "tunm must be enclosed by areaid.ce";
    NOT tunm areaid.ce;
}
AND poly_dg areaid.ce -outputlayer poly_core;
NOT poly_dg areaid.ce -outputlayer poly_notcore;

RULE CDR.poly.1a {
    CAPTION "CDR: Min width of poly: 0.15 um";
    INTE poly_dg -lt 0.15 -output region;
}

RULE poly.1b {
    CAPTION "Min channel length (poly width) for pfet overlapping lvtn: 0.35 um";
    CAPTION "(exempt rule for dummy_poly in cells listed on Table H3)";
    SELECT -interact pfet lvtn -outputlayer poly.1b_a;
    INTE poly.1b_a -lt 0.35 -output region;
}

RULE CDR.poly.2 {
    CAPTION "CDR: Min spacing of poly to poly outside of areaid.ce: 0.21 um";
    EXTE poly_notcore -lt 0.21 -output region;
}
EDGE_LENGTH poly_core -le 0.15 -outputlayer poly_gap_edge;
EDGE_LENGTH poly_core -gt 0.2 -outputlayer poly_not_gap_edge;

RULE CDR.poly.2a {
    EXTE poly_gap_edge -lt 0.16 -para only -output region;
    CAPTION "CDR: Min spacing of poly core gap: 0.16 um";
    CAPTION "  (end-to-end spacing of poly in areaid.ce) ";
}

RULE CDR.poly.2b {
    EXTE poly_not_gap_edge -lt 0.175 -para only -output region;
    CAPTION "CDR: Min spacing of poly inside areaid.ce: 0.175 um";
    CAPTION "  (except for end-to-end spacing of poly in areaid.ce) ";
}

RULE poly.4a {
    CAPTION "Min spacing of poly on field (outside areaid.ce) to diff (parallel edges only): 0.075 um";
    EXTE poly_notcore diff -lt 0.075 -abut -eq 0 -para only -output region;
}

RULE poly.4b {
    CAPTION "Min spacing of poly in core (inside areaid.ce) to diff: 0.03 um";
    EXTE poly_core diff -lt 0.03 -para only -output region;
}

RULE poly.5a {
    CAPTION "Min spacing of poly on field (outside areaid.ce) to tap: 0.055 um";
    EXTE poly_notcore tap -lt 0.055 -single_point -output region;
}

RULE poly.5b {
    CAPTION "Min spacing of poly in core (inside areaid.ce) to tap: 0.03 um";
    EXTE poly_core tap -lt 0.03 -single_point -output region;
}
AND ptap psdm ptap_actual;
AND ntap nsdm ntap_actual;
AND pdiff psdm pdiff_actual;
AND ndiff nsdm ndiff_actual;
SELECT -touch ptap_actual ndiff_actual -outputlayer tap_ndiff;
SELECT -touch ntap_actual pdiff_actual -outputlayer tap_pdiff;

RULE poly.9a {
    CAPTION "Min poly resistor spacing to diff/tap: 0.48 um";
    EXTE poly_res diff_in -lt 0.48 -abut -lt 90 -single_point -output region;
}

RULE poly.9b {
    CAPTION "Min poly resistor spacing to poly: 0.21" um;
    EXTE poly_res poly_dg -lt 0.21 -abut -ltgt 0 90 -single_point -output region;
}
AND poly poly_res -outputlayer poly_res_body;

RULE CDR.poly.3 {
    CAPTION "CDR: Min poly resistor width: 0.33 um";
    INTE poly_res_body -lt 0.33 -output region;
}

RULE poly.3a {
    CAPTION "Poly resistor must be covered by poly";
    NOT poly_res poly;
}
AND poly_res rpm_urpm _EPTMPL262564;
EDGE_BOOLEAN -coincident_only -inside _EPTMPL262564 poly -outputlayer poly_prec_len;
NOT poly_res rpm_urpm _EPTMPL262566;
EDGE_BOOLEAN -coincident_only -inside _EPTMPL262566 poly -outputlayer poly_res_len;

RULE CDR.poly.3b {
    CAPTION "CDR: Min length of precision poly resistor: 0.66 um";
    PATH_LENGTH poly_prec_len -lt 0.66;
}

RULE CDRW.poly.3c {
    CAPTION "CDRW: Min length of non-precision poly resistor: 0.47 um";
    PATH_LENGTH poly_res_len -lt 0.47;
}
ENC poly_notcore diff_in -lt 0.25 -output region -outputlayer poly_dif_enc;
SELECT -inside poly_dif_enc diff_in -outputlayer poly.7;

RULE poly.7 {
    CAPTION "Min extension of diff beyond poly in periphery (outside areaid.ce): 0.25 um";
    COPY poly.7;
}
SELECT -interact -not gate tap _EPTMPL262573;
EDGE_BOOLEAN -coincident_only -inside _EPTMPL262573 diff -outputlayer gate_endcap;
EDGE_BOOLEAN -outside gate_endcap areaid.ce -outputlayer gate_peri_endcap;

RULE poly.8 {
    CAPTION "Min extension of poly outside areaid.ce beyond gate end (endcap): 0.13 um";
    ENC gate_peri_endcap poly -lt 0.13 -output region;
}
AND poly_dg diff_in polydiff;
VERTEX polydiff -gt 4 -outputlayer polydiff_gt4;
BBOX polydiff_gt4 -outputlayer polydiff_bbox;
SELECT polydiff_bbox -inside diff -outputlayer poly_has_bend;
SELECT polydiff_bbox -inside poly -outputlayer diff_has_bend;

RULE poly.10 {
    CAPTION "Poly cannot overlap inner corners of diff";
    COPY diff_has_bend;
}
SELECT polydiff_gt4 -inside poly_has_bend -outputlayer poly_11_maybe;
NOT poly_has_bend poly_11_maybe poly_11_not;
RECT_CHK poly_11_not -orthogonal_only -outputlayer poly_11;

RULE poly.11 {
    CAPTION "No 90 deg turns of poly on diff";
    COPY poly_11;
}
NOT nwell hvi -outputlayer poly.12_a;
SELECT -interact -not poly_dg poly.12_a -outputlayer poly.12_b;
SELECT -donut -not poly.12_b -outputlayer poly.12_c;

RULE poly.12 {
    CAPTION "(Poly NOT (nwell NOT hvi)) may not overlap tap";
    CAPTION "Rule exempted for gated_npn and inside UHVI.";
    AND tap psdm _EPTMPL262590;
    AND poly.12_c poly.12:_EPTMPL262590;
}

RULE poly.15 {
    CAPTION "Poly must not overlap diff:rs (diff res)";
    AND poly diff_res;
}

RULE CDR.rpm.1a {
    CAPTION "CDR: Min width of rpm: 1.27 um";
    INTE rpm -lt 1.27 -single_point -output region;
}

RULE CDR.rpm.2 {
    CAPTION "CDR: Min spacing of rpm: 0.84 um";
    EXTE rpm -lt 0.84 -single_point -output region;
}

RULE rpm.3 {
    CAPTION "Min enclosure of prec_resistor by rpm: 0.20 um";
    ENC rpm prec_resistor -lt 0.2 -output region;
}

RULE rpm.4 {
    CAPTION "Min enclosure of prec_resistor by psdm: 0.11 um";
    ENC prec_resistor psdm -lt 0.11 -output region;
}

RULE rpm.5 {
    CAPTION "Min enclosure of prec_resistor by npc: 0.095 um";
    ENC prec_resistor npc -lt 0.095 -output region;
}

RULE rpm.6 {
    CAPTION "Min spacing, no overlap, of rpm and nsdm: 0.20 um";
    EXTE rpm nsdm -lt 0.2 -overlap -single_point -output region;
}

RULE rpm.7 {
    CAPTION "Min spacing between rpm and poly: 0.20 um";
    EXTE rpm poly -lt 0.2 -single_point -output region;
}

RULE rpm.8 {
    CAPTION "poly must not straddle rpm";
    SELECT -cut poly rpm;
}

RULE rpm.9 {
    CAPTION "Min space, no overlap, between prec_resistor and hvntm: 0.185 um";
    EXTE prec_resistor hvntm -lt 0.185 -overlap -single_point -output region;
}

RULE rpm.11 {
    CAPTION "rpm should not overlap or straddle pwbm";
    SELECT -interact rpm pwbm;
}

RULE CDR.urpm.1a {
    CAPTION "CDR: Min width of urpm: 1.27 um";
    INTE urpm -lt 1.27 -single_point -output region;
}

RULE CDR.urpm.2 {
    CAPTION "CDR: Min spacing of urpm: 0.84 um";
    EXTE urpm -lt 0.84 -single_point -output region;
}

RULE varac.1 {
    CAPTION "Min channel length (poly width) of Var_channel: 0.18 um";
    AND poly Var_channel -outputlayer varac.1_a;
    INTE varac.1_a -lt 0.18 -output region;
}

RULE varac.2 {
    CAPTION "Min channel width (tap width) of Var_channel: 1.00 um";
    AND tap Var_channel -outputlayer varac.2_a;
    INTE varac.2_a -lt 1 -output region;
}

RULE varac.3 {
    CAPTION "Min spacing between hvtp to Var_channel: 0.18 um";
    EXTE hvtp Var_channel -lt 0.18 -single_point -output region;
}

RULE varac.5 {
    CAPTION "Min enclosure of poly overlapping Var_channel by nwell: 0.15 um";
    SELECT -cut poly Var_channel -outputlayer varac.5_a;
    ENC varac.5_a nwell -lt 0.15 -output region;
}

RULE varac.7 {
    CAPTION "Nwell overlapping Var_channel must not overlap P+ diff";
    SELECT -cut nwell Var_channel -outputlayer varac.7_a;
    AND varac.7_a pdiff;
}

RULE varac.8 {
    CAPTION "Min enclosure of Var_channel by hvtp: 0.255";
    ENC Var_channel hvtp -lt 0.255 -output region;
}
AND areaid.po dnwell _EPTMPL262615;
SELECT -enclose _EPTMPL262615 nwell -outputlayer photo;

RULE photo.2 {
    CAPTION "Min/Max width of photoDiode: 3.0 um ";
    INTE photo -lt 3 -output region;
}

RULE photo.3 {
    CAPTION "Min spacing between photoDiode: 5.0 um ";
    EXTE photo -lt 5 -output region;
}

RULE CDR.npc.1 {
    CAPTION "CDR: Min width of npc: 0.27 um";
    INTE npc -lt 0.27 -output region;
}

RULE CDR.npc.2 {
    CAPTION "CDR: Min spacing/notch of npc: 0.27 um";
    CAPTION "Rule npc.3 Manual merge if less than minimum";
    EXTE npc -lt 0.27 -single_point -output region;
}

RULE npc.4 {
    CAPTION "Spacing (no overlap) of NPC to Gate: 0.09 um";
    EXTE npc gate -lt 0.09 -single_point -overlap -output region;
}
AND nsdm areaid.ce nsdm.core;
NOT nsdm areaid.ce nsdm.ncore;
AND psdm areaid.ce psdm.core;
NOT psdm areaid.ce psdm.ncore;

RULE CDR.psd.1a {
    CAPTION "CDR: Min width of nsdm / psdm outside areaid.ce: 0.38 um";
    INTE nsdm.ncore -lt 0.38 -output region;
    INTE psdm.ncore -lt 0.38 -output region;
}

RULE CDR.psd.1b {
    CAPTION "CDR: Min width of nsdm / psdm inside areaid.ce: 0.29 um";
    INTE nsdm.core -lt 0.29 -output region;
    INTE psdm.core -lt 0.29 -output region;
}

RULE CDR.psd.2 {
    CAPTION "CDR: Min spacing of nsdm(psdm) to nsdm(psdm): 0.38 um";
    CAPTION "psd.3 - Manual merge if less than minimum";
    EXTE nsdm -lt 0.38 -single_point -output region;
    EXTE psdm -lt 0.38 -single_point -output region;
}
OR nsdm psdm -outputlayer psd.5;

RULE psd.5a {
    CAPTION "Min enclosure of diff by nsdm(psdm), except for butting edge: 0.125 um";
    ENC diff psd.5 -lt 0.125 -output region;
}

RULE psd.5b {
    CAPTION "Min enclosure of tap by nsdm(psdm), except for butting edge: 0.125 um";
    ENC tap_dg psd.5 -lt 0.125 -output region;
}

RULE psd.7 {
    CAPTION "Spacing of nsdm/psdm opposite implant diff or tap -lt 0.130";
    CAPTION "(for non-abutting diff/tap edges)";
    EXTE nsdm pdiff_actual -ltgt 0 0.13 -output region;
    EXTE psdm ndiff_actual -ltgt 0 0.13 -output region;
}

RULE psd.8 {
    CAPTION "Nsdm and psdm cannot overlap diff/tap regions of opposite doping";
    AND nsdm psdm;
}

RULE psd.9 {
    CAPTION "WARNING: Ddiff and tap must be enclosed by their corresponding implant layers.";
    CAPTION "Rule exempted for diff rings around the die";
    CAPTION "Rule exempted for gated_npn & areaid.zr";
    OR npn areaid.zr SEALID -outputlayer psd.9_exempt;
    OR nsdm psdm _EPTMPL262639;
    NOT psd.9:_EPTMPL262639 psd.9_exempt -outputlayer psd.9_a;
    SELECT -outside diff_dg psd.9_exempt _EPTMPL262641;
    NOT psd.9:_EPTMPL262641 psd.9_a;
    SELECT -outside tap_dg psd.9_exempt _EPTMPL262643;
    NOT psd.9:_EPTMPL262643 psd.9_a;
}

RULE psd.10a {
    CAPTION "Min area of nsdm: 0.265 sq um";
    AREA nsdm -lt 0.265;
}

RULE psd.10b {
    CAPTION "Min area of psdm: 0.255 sq um";
    AREA psdm -lt 0.255;
}

RULE psd.11 {
    CAPTION "Min area of nsdm/psdm Holes: 0.265 sq um";
    HOLES nsdm -outputlayer psd.11_a;
    AREA psd.11_a -lt 0.265;
    HOLES psdm -outputlayer psd.11_b;
    AREA psd.11_b -lt 0.265;
}
SELECT -inside licon SEALID -outputlayer licon_insideSR;
NOT licon licon_insideSR licon_outsideSR;
OR rpm urpm _EPTMPL262653;
SELECT -interact -not licon _EPTMPL262653 -outputlayer licon_not_precR;
NOT licon licon_not_precR licon_precR;
SELECT -interact licon areaid.ce -outputlayer licon_core;
NOT licon licon_core -outputlayer licon_notcore;
RECT_CHK licon_outsideSR -aspect -eq 1 -outputlayer licon_square;
AND poly licon -outputlayer poly_licon;
AND poly licon_notcore -outputlayer poly_licon_notcore;
AND poly licon_core -outputlayer poly_licon_core;

RULE CDR.licon.1 {
    CAPTION "CDR: Min and max L and W of licon, except for bar licon: 0.17 um";
    RECT_CHK -not licon_not_precR -eq 0.17 -by -eq 0.17 -orthogonal_only;
}
RECT_CHK licon_precR -eq 0.17 -by -eq 0.17 -outputlayer licon_017_in_prec;

RULE licon.1a {
    CAPTION "licon sized 0.17 um X 0.17 um found in precision resistor -- ";
    CAPTION "licon inside (rpm OR urpm) should be 0.19 um X 2.0 um bar licon " ;
    COPY licon_017_in_prec;
}

RULE CDR.licon.1b {
    CAPTION "CDR: Min and max width of bar licon == 0.19 um";
    NOT licon_precR licon_017_in_prec _EPTMPL262665;
    RECT_CHK -not CDR.licon.1b:_EPTMPL262665 -eq 0.19;
}

RULE CDR.licon.1c {
    CAPTION "CDR: Min and max length of bar licon == 2.00 um";
    NOT licon_precR licon_017_in_prec _EPTMPL262667;
    RECT_CHK -not CDR.licon.1c:_EPTMPL262667 -eq 2;
}

RULE licon.3 {
    CAPTION "Only min. square licons are allowed except die seal ring where licons are (licon CD)*L: 0.17 um";
    CAPTION "  this seal ring licon does not have width = 0.17 um ";
    RECT_CHK -not licon_insideSR -eq 0.17;
}

RULE CDR.licon.2 {
    CAPTION "CDR: Min spacing of licon to licon: 0.17 um";
    CAPTION "  For non-bar licon outside of areaid.ce ";
    EXTE licon_notcore -lt 0.17 -single_point -output region;
}

RULE CDR.licon.2a {
    CAPTION "CDR: Min spacing of licon to licon: 0.165 um";
    CAPTION "  For non-bar licon inside of areaid.ce ";
    EXTE licon_core -lt 0.165 -single_point -output region;
}
RECT_CHK licon -eq 0.19 -by -eq 2 -outputlayer licon_bar;

RULE CDR.licon.2b {
    CAPTION "CDR: Min end-to-end space of bar licon: 0.35 um";
    EDGE_LENGTH licon_bar -lt 2 -outputlayer licon_end;
    EXTE licon_end -lt 0.35 -abut -lt 90 -output region;
}

RULE CDR.licon.2c {
    CAPTION "CDR: Min side-to-side spacing of bar licon: 0.51 um";
    EDGE_LENGTH licon_bar -gt 0.19 -outputlayer licon_side;
    EXTE licon_side -lt 0.51 -abut -lt 90 -output region;
}

RULE CDR.licon.2d {
    CAPTION "CDR: Min space from bar licon to square licon: 0.51 um";
    EXTE licon_square licon_bar -lt 0.51 -abut -lt 90 -output region -single_point;
}

RULE CDR.licon.5b {
    CAPTION "CDR: Min space between tap_licon outside areaid.ce and diff-abutting tap edge: 0.06 um";
    AND tap licon_notcore -outputlayer licon.5b;
    EDGE_BOOLEAN -coincident_only -outside diff tap _EPTMPL262679;
    EXTE licon.5b CDR.licon.5b:_EPTMPL262679 -lt 0.06 -abut -lt 90 -output region;
}

RULE CDR.licon.9 {
    CAPTION "CDR: Min spacing, no overlap, between poly_licon outside areaid.ce and psdm: 0.11 um";
    SELECT -outside poly_licon_notcore rpm_urpm -outputlayer licon.9_a;
    EXTE licon.9_a psdm -lt 0.11 -overlap -output region;
    AND licon.9_a psdm;
}

RULE licon.14a {
    CAPTION "Min spacing of poly_licon outside areaid.ce to diff or tap: 0.19 um";
    OR diff tap -outputlayer licon.14_2;
    EXTE poly_licon_notcore licon.14_2 -lt 0.19 -output region;
}

RULE licon.14b {
    CAPTION "Min spacing of poly_licon inside areaid.ce to diff or tap: 0.13 um";
    OR diff tap -outputlayer licon.14a_2;
    EXTE poly_licon_core licon.14a_2 -lt 0.19 -output region;
}

RULE licon.4a {
    CAPTION "licon must be inside li";
    NOT licon li1;
}

RULE licon.4b {
    CAPTION "licon must be inside (poly or diff or tap)";
    OR poly diff tap _EPTMPL262689;
    NOT licon licon.4b:_EPTMPL262689;
}

RULE licon.5a {
    CAPTION "Min enclosure of licon outside areaid.ce by diff (not tap): 0.04 um";
    ENC licon_notcore diff_all -lt 0.04 -output region;
    EDGE_SELECT licon_notcore diff;
}

RULE licon.5c {
    CAPTION "Min enclosure of licon outside areaid.ce by diff on one of two adjacent sides: 0.06 um";
    RECT_ENC licon_notcore diff_in -good 0.06 0 0.06 0;
}
EDGE_BOOLEAN -coincident_only -outside tap diff _EPTMPL262694;
SELECT -with_edge tap _EPTMPL262694 -outputlayer non_isolated_tap;
NOT tap non_isolated_tap -outputlayer isolated_tap;

RULE licon.7 {
    CAPTION "Min enclosure of licon outside areaid.ce by one of two adjacent sides of isolated tap: 0.12 um";
    RECT_ENC licon_notcore isolated_tap -good 0.12 0 0.12 0;
}

RULE licon.8 {
    CAPTION "Min enclosure of poly_licon outside areaid.ce by poly: 0.05 um";
    ENC poly_licon_notcore poly -lt 0.05 -output region;
    EDGE_SELECT poly_licon_notcore poly;
}

RULE licon.8a {
    CAPTION "Min enclosure of poly_licon outside areaid.ce by poly on one of two adjacent sides: 0.08 um";
    RECT_ENC poly_licon_notcore poly -good 0.08 0 0.08 0;
}

RULE licon.15a {
    CAPTION "Min enclosure of poly_licon outside areaid.ce by npc: 0.10 um";
    ENC poly_licon_notcore npc -lt 0.1 -output region;
    EDGE_SELECT poly_licon_notcore npc;
}

RULE CDR.licon.15b {
    CAPTION "CDR: Min enclosure of poly_licon inside areaid.ce by npc: 0.045 um";
    ENC poly_licon_core npc -lt 0.045 -output region;
    EDGE_SELECT poly_licon_core npc;
}

RULE licon.6 {
    CAPTION "licon cannot straddle tap";
    OR ptap_actual ntap_actual _EPTMPL262705;
    SELECT -cut licon licon.6:_EPTMPL262705;
}

RULE licon.11 {
    CAPTION "Spacing of licon on diff or tap to poly on diff: 0.055 um";
    CAPTION "(except for all FETs inside areaid.sc";
    CAPTION "and except s8spf-10r flow for 0.5um phv inside cell names s8fs_gwdlvx4,";
    CAPTION "s8fs_gwdlvx8, s8fs_hvrsw_x4, s8fs_hvrsw8, s8fs_hvrsw264,";
    CAPTION "and s8fs_hvrsw520 and for 0.15um nshort inside cell names s8fs_rdecdrv,";
    CAPTION "s8fs_rdec8, s8fs_rdec32, s8fs_rdec264, s8fs_rdec520)";
    CAPTION "NOTE: exceptions have NOT been considered, there may be false errors";
    NOT gate areaid.sc -outputlayer licon.11_a;
    OR diff tap -outputlayer licon.11_b;
    AND licon_notcore licon.11_b -outputlayer licon.11_c;
    EXTE licon.11_a licon.11_c -lt 0.055 -output region;
}

RULE CDR.licon.11a {
    CAPTION "CDR: Spacing of licon on diff or tap to poly on diff: 0.05 um";
    CAPTION "(for all FETs inside areaid.sc except 0.15um phighvt)";
    CAPTION "NOTE: exceptions have NOT been considered, there may be false errors";
    AND gate areaid.sc -outputlayer licon.11a_a;
    OR diff tap -outputlayer licon.11a_b;
    AND licon_notcore licon.11a_b -outputlayer licon.11a_c;
    AND licon.11a_a diff -outputlayer licon.11a_d;
    EXTE licon.11a_c licon.11a_d -lt 0.05 -output region;
}
NOT diff gate -outputlayer diff_not_gate;
SELECT -enclose -not diff_not_gate licon -outputlayer diff_no_licon;
EDGE_SELECT -coincident_only diff_no_licon gate -outputlayer diff_no_licon_edge;
EDGE_LENGTH diff_no_licon_edge -gt 5.7 -outputlayer diff_edge57_no_licon;

RULE licon.12 {
    CAPTION "GUIDELINE: Max SD width without licon: 5.70 um";
    COPY diff_edge57_no_licon;
}

RULE CDR.licon.13 {
    CAPTION "CDR: Spacing (no overlap) of NPC to licon on diff or tap: 0.09 um";
    OR diff tap -outputlayer licon.13_a;
    AND licon licon.13_a -outputlayer licon.13_b;
    EXTE npc licon.13_b -lt 0.09 -overlap -output region;
}

RULE CDR.licon.17 {
    CAPTION "CDR: licon may not overlap both poly and (diff or tap)";
    SELECT -cut licon poly -outputlayer licon.17_a;
    OR diff tap -outputlayer licon.17_b;
    SELECT -cut licon.17_a licon.17_b;
    AND diff poly _EPTMPL262727;
    AND licon CDR.licon.17:_EPTMPL262727;
}

RULE licon.18 {
    CAPTION "npc must enclose poly_licon";
    NOT poly_licon npc;
}

RULE licon.20 {
    CAPTION "Every tap must enclose at least 1 licon (except in uhvi)";
    NOT tap areaid.ce -outputlayer tap_not_core;
    SELECT -cut tap areaid.ce _EPTMPL262731;
    OR tap_not_core licon.20:_EPTMPL262731 -outputlayer npcon_tap;
    NOT npcon_tap diff_fill _EPTMPL262733;
    SELECT -enclose -not licon.20:_EPTMPL262733 licon _EPTMPL262734;
    NOT licon.20:_EPTMPL262734 uhvi;
}

RULE licon.21 {
    CAPTION "psdm overlapping (poly and licon) is prohibited inside areaid.ce";
    AND poly_licon_core psdm _EPTMPL262736;
    AND licon.21:_EPTMPL262736 areaid.ce;
}

RULE licon.core {
    CAPTION "WARNING: licon straddling areaid.ce (CORE)";
    SELECT -cut licon areaid.ce _EPTMPL262738;
    NOT licon.core:_EPTMPL262738 areaid.ce;
}
SELECT -cut li_dg areaid.ce -outputlayer li_crossing_core;
SELECT -inside li_dg areaid.ce -outputlayer li_inside_core;
SELECT -outside li_dg areaid.ce -outputlayer li_outside_core;
NOT li_dg areaid.ce -outputlayer li_notcore;
AND li_dg areaid.ce -outputlayer li_core;

RULE CDR.li.1a {
    CAPTION "CDR: Width of LI inside areaid.ce: 0.14 um";
    INTE li_inside_core -lt 0.14 -output region;
}

RULE CDR.li.1b {
    CAPTION "CDR: Width of LI outside areaid.ce: 0.17 um";
    INTE li_outside_core -lt 0.17 -output region;
}

RULE CDR.li.1c {
    CAPTION "CDR: Width of LI crossing areaid.ce border: 0.17 um";
    INTE li_crossing_core -lt 0.17 -output region;
}

RULE CDR.li.3a {
    CAPTION "CDR: Spacing of LI to LI inside areaid.ce: 0.14 um";
    EXTE li_inside_core li1 -lt 0.14 -single_point -output region;
}

RULE CDR.li.3b {
    CAPTION "CDR: Spacing of LI to LI outside areaid.ce: 0.17 um";
    EXTE li_outside_core li1 -lt 0.17 -single_point -output region;
}

RULE CDR.li.3c {
    CAPTION "CDR: Spacing of LI to LI crossing areaid.ce border: 0.17 um";
    EXTE li_crossing_core li1 -lt 0.17 -single_point -output region;
}

RULE CDR.li.5 {
    CAPTION "CDR: Min enclosure of licon outside areaid.ce by one of two adjacent LI sides: 0.08 um";
    RECT_ENC licon_notcore li1 -good 0 0.08 0 0.08;
}

RULE CDR.li.6 {
    CAPTION "CDR: Min area of LI: 0.0561 sq um";
    AREA li_outside_core -lt 0.0561;
}
SELECT -inside li1_res areaid.ed li1_res_esd;
NOT li1_res li1_res_esd li1_res_not_esd;

RULE CDR.li.7 {
    CAPTION "CDR: Min LI resistor width 0.29 um";
    INTE li1_res -lt 0.29 -output region;
}

RULE CDR.mcon.1 {
    CAPTION "CDR: Min and max L and W of mcon: 0.17 um";
    RECT_CHK mcon -ne 0.17 -orthogonal_only;
}

RULE CDR.mcon.2 {
    CAPTION "CDR: Min spacing of mcon: 0.19 um";
    EXTE mcon -lt 0.19 -single_point -output region;
}

RULE mcon.core {
    CAPTION "WARNING: mcon straddling areaid.ce (CORE)";
    SELECT -cut mcon areaid.ce _EPTMPL262758;
    NOT mcon.core:_EPTMPL262758 areaid.ce;
}
AND met3 capm -outputlayer m3_bot_plate;
NOT met3 capm -outputlayer m3_not_capm;

RULE capm.1a {
    CAPTION "met3 must completely enclose capm";
    NOT capm m3_dg;
}

RULE capm.1b {
    CAPTION "capm without met4 is prohibited";
    SELECT -outside capm m4_dg;
}

RULE capm.2a {
    CAPTION "capm without via3 is prohibited";
    SELECT -interact -not capm via3;
}

RULE capm.2b {
    CAPTION "capm must contain at least 2 via3";
    SELECT -enclose capm -lt 2 via3;
}
SIZE -by 0.14 m3_bot_plate -outputlayer m3_capm_plate;
EXTE -lt 1.2 m3_capm_plate -output region -outputlayer capm.3a.possible;
SELECT -inside -not capm.3a.possible met3 -outputlayer capm.3a_part;
EXTE -lt 0.145 capm capm.3a_part -output region -outputlayer capm.3a_part2;

RULE capm.3a {
    CAPTION "Min space between capm bottom plates";
    CAPTION "For this rule, capm is extended by 0.14 um to form bottom plate";
    OR capm.3a_part capm.3a_part2;
}
AND m3_dg capm -outputlayer cap_bot;
SIZE -by 1.34 cap_bot -outputlayer cap_bot_1p2;
CONNECT cap_bot_1p2 met3 -by capm;
AND cap_bot_1p2 met3 -not_connected -outputlayer met3_not_connected;
EXTE -lt 1.34 cap_bot met3_not_connected -output region -outputlayer capm.m3_too_close;
SELECT -enclose m3_dg capm -outputlayer m3_capm_enclose;
EDGE_EXPAND m3_capm_enclose -inside_by 0.005 -outputlayer met3_capm_edge;
CONNECT cap_bot met3;
CONNECT met3_capm_edge met3;

RULE CDR.capm.3b {
    CAPTION "CDR: Min space capm bottom plates to unconnected met3: 1.2 um";
    CAPTION "For this rule, capm is extended by 0.14 um to form bottom plate";
    EXTE -lt 1.2 cap_bot met3_capm_edge -exclude_shielded 0 -not_connected -output region;
    COPY capm.m3_too_close;
}

RULE CDR.capm.3c {
    CAPTION "CDR: Min capm space: 0.84 um";
    EXTE capm -lt 0.84 -abut -lt 90 -single_point -output region;
}

RULE CDR.capm.4 {
    CAPTION "CDR: Min capm width: 1.0 um";
    INTE capm -lt 1 -abut -lt 90 -single_point -output region;
}

RULE CDR.capm.5 {
    CAPTION "CDR: Min enclosure of capm by met3: 0.14 um";
    ENC capm m3_dg -lt 0.14 -measure all -abut -lt 90 -single_point -output region;
}

RULE CDR.capm.6 {
    CAPTION "CDR: Min enclosure of via3 by capm: 0.14 um";
    ENC via3 capm -lt 0.14 -measure all -abut -lt 90 -single_point -output region;
}

RULE CDR.capm.7 {
    CAPTION "CDR: Min spacing of capm and via3: 0.14 um ";
    EXTE capm via3 -lt 0.14 -abut -lt 90 -single_point -output region;
    SELECT -touch via3 capm;
}

RULE capm.8a {
    CAPTION "Max capm aspect ratio (L/W): 20.0 um";
    RECT_CHK capm -aspect -gt 20;
}

RULE capm.8b {
    CAPTION "Only rectangular capm is permitted";
    RECT_CHK -not capm;
}

RULE capm.8c {
    CAPTION "Max area of capm: 1,000,000 square um";
    AREA capm -gt 1000000;
}

RULE capm.9a {
    CAPTION "Min space of capm to via2: 0.14 um";
    EXTE capm via2 -lt 0.14 -abut -lt 90 -single_point -output region;
    SELECT -touch via2 capm;
}

RULE capm.9b {
    CAPTION "capm cannot overlap via2";
    AND capm via2;
}
AND met4 cap2m -outputlayer m4_bot_plate;

RULE cap2m.1a {
    CAPTION "cap2m without met4 is prohibited";
    NOT cap2m m4_dg;
}

RULE cap2m.1b {
    CAPTION "cap2m without met5 is prohibited";
    SELECT -outside cap2m m5_dg;
}

RULE cap2m.2a {
    CAPTION "cap2m without via4 is prohibited";
    SELECT -interact -not cap2m via4;
}

RULE cap2m.2b {
    CAPTION "cap2m must contain at least 2 via4";
    SELECT -enclose cap2m -lt 2 via4;
}
SIZE -by 0.14 m4_bot_plate -outputlayer m4_cap2m_plate;
EXTE -lt 1.2 m4_cap2m_plate -output region -outputlayer cap2m.3a.possible;
SELECT -inside -not cap2m.3a.possible met4 -outputlayer cap2m.3a_part;
EXTE -lt 0.145 cap2m cap2m.3a_part -output region -outputlayer cap2m.3a_part2;

RULE CDR.cap2m.3a {
    CAPTION "CDR: Min space between cap2m bottom plates";
    CAPTION "For this rule, cap2m is extended by 0.14 um to form bottom plate";
    OR cap2m.3a_part cap2m.3a_part2;
}
AND m4_dg cap2m -outputlayer cap2m_bot;
SIZE -by 1.34 cap2m_bot -outputlayer cap2m_bot_1p2;
CONNECT cap2m_bot_1p2 met4 -by cap2m;
AND cap2m_bot_1p2 met4 -not_connected -outputlayer met4_not_connected;
EXTE -lt 1.34 cap2m_bot met4_not_connected -output region -outputlayer cap2m.m4_too_close;
SELECT -enclose m4_dg cap2m -outputlayer m4_cap2m_enclose;
EDGE_EXPAND m4_cap2m_enclose -inside_by 0.005 -outputlayer met4_cap2m_edge;
CONNECT cap2m_bot met4;
CONNECT met4_cap2m_edge met4;

RULE CDR.cap2m.3b {
    CAPTION "CDR: Min space cap2m bottom plates to unconnected met4: 1.2 um";
    CAPTION "For this rule, cap2m is extended by 0.14 um to form bottom plate";
    EXTE -lt 1.2 cap2m_bot met4_cap2m_edge -exclude_shielded 0 -not_connected -output region;
    COPY cap2m.m4_too_close;
}

RULE CDR.cap2m.3c {
    CAPTION "CDR: Min cap2m space: 0.84 um";
    EXTE cap2m -lt 0.84 -abut -lt 90 -single_point -output region;
}

RULE CDR.cap2m.4 {
    CAPTION "CDR: Min cap2m width: 1.0 um";
    INTE cap2m -lt 1 -abut -lt 90 -single_point -output region;
}

RULE CDR.cap2m.5 {
    CAPTION "CDR: Min enclosure of cap2m by met4: 0.14 um";
    ENC cap2m m4_dg -lt 0.14 -measure all -abut -lt 90 -single_point -output region;
}

RULE CDR.cap2m.6 {
    CAPTION "CDR: Min enclosure of via4 by cap2m: 0.2 um";
    ENC via4 cap2m -lt 0.2 -measure all -abut -lt 90 -single_point -output region;
}

RULE CDR.cap2m.7 {
    CAPTION "CDR: Min spacing of cap2m and via4: 0.2 um ";
    EXTE cap2m via4 -lt 0.2 -single_point -output region;
    SELECT -touch via4 cap2m;
}

RULE cap2m.8a {
    CAPTION "Max cap2m aspect ratio (L/W): 20.0 um";
    RECT_CHK cap2m -aspect -gt 20;
}

RULE cap2m.8b {
    CAPTION "Only rectangular cap2m is permitted";
    RECT_CHK -not cap2m;
}

RULE cap2m.8c {
    CAPTION "Max area of cap2m: 1,000,000 square um";
    AREA cap2m -gt 1000000;
}

RULE cap2m.9a {
    CAPTION "Min space of cap2m to via3: 0.14 um";
    EXTE cap2m via3 -lt 0.14 -single_point -output region;
    SELECT -touch via3 cap2m;
}

RULE cap2m.9b {
    CAPTION "cap2m cannot overlap via3 except for stacked capm / cap2m capacitors";
    NOT via3 capm _EPTMPL262826;
    AND cap2m cap2m.9b:_EPTMPL262826;
}

RULE vpp.1 {
    CAPTION "GUIDELINE: Min width of capacitor:dg: 1.43 um";
    INTE capacitor_in -lt 1.43 -single_point -output region;
}

RULE vpp.8 {
    CAPTION "GUIDELINE: Min enclosure of capacitor:dg by nwell: 1.50 um";
    ENC capacitor_in nwell -lt 1.5 -output region;
}

RULE vpp.9 {
    CAPTION "GUIDELINE: Min spacing of capacitor:dg to nwell (not applicable for vpp_over_MOSCAP): 1.50 um";
    EXTE capacitor_in nwell -lt 1.5 -single_point -output region;
}

RULE vpp.13 {
    CAPTION "GUIDELINE: Min space of met1 to met1 inside VPP capacitor: 0.16 um";
    AND met1 capacitor_in -outputlayer met1_cap;
    SELECT -outside met1 capacitor_in -outputlayer met1_notcap;
    EXTE met1_cap met1_notcap -lt 0.16 -single_point -output region;
}

RULE vpp.14 {
    CAPTION "GUIDELINE: Min space of met2 to met2 inside VPP capacitor: 0.16 um";
    AND met2 capacitor_in -outputlayer met2_cap;
    SELECT -outside met2 capacitor_in -outputlayer met2_notcap;
    EXTE met2_cap met2_notcap -lt 0.16 -single_point -output region;
}

RULE CDR.m1.1 {
    CAPTION "CDR: Min width of met1: 0.14 um";
    INTE m1_dg -lt 0.14 -output region;
}

RULE CDR.m1.2 {
    CAPTION "CDR: Min spacing/notch of met1: 0.14 um";
    EXTE m1_dg -lt 0.14 -single_point -output region;
}
NOT m1_dg huge_met1 met1_not_huge;
SIZE huge_met1 -by 0.28 -inside_of m1_dg -outputlayer huge_met1_028;
AND met1_not_huge huge_met1_028 met1_huge_and;
SELECT -touch met1_huge_and huge_met1 -outputlayer met1_touching_huge;

RULE CDRW.m1.3a {
    CAPTION "CDRW: Min spacing of huge met1 (width > 3.0 um) to narrow met1,";
    CAPTION "including features extending 0.28 um into narrow met1: 0.28 um";
    EXTE met1_touching_huge m1_dg -lt 0.28 -single_point -output region;
}

RULE CDRW.m1.3b {
    CAPTION "CDRW: Min spacing of huge_met1 to met1 excluding features checked by m1.3a: 0.28 um";
    EXTE huge_met1 m1_dg -lt 0.28 -single_point -output region;
}
INSIDE_CELL mcon "s8cell_ee_plus_sseln_a" "s8cell_ee_plus_sseln_b" "s8cell_ee_plus_sselp_a" "s8cell_ee_plus_sselp_b" "s8fpls_pl8" "s8fs_cmux4_fm" -outputlayer "mcon_m1.4a";
NOT mcon mcon_m1.4a mcon_m1.4;
NOT mcon areaid.ce mcon_notcore;
AND mcon areaid.ce mcon_core;

RULE CDR.m1.4 {
    CAPTION "CDR: Mcon outside areaid.ce must be enclosed by met1 by at least: 0.03 um";
    ENC mcon_notcore m1_dg -lt 0.03 -output region;
    EDGE_SELECT mcon_notcore met1;
}

RULE CDR.m1.4a {
    CAPTION "CDR: Mcon inside areaid.ce must be enclosed by met1 by at least: 0.005";
    ENC mcon_core m1_dg -lt 0.005 -output region;
    EDGE_SELECT mcon_core m1_dg;
}

RULE CDR.m1.5 {
    CAPTION "CDR: mcon outside areaid.ce must be enclosed by met1 on one of two adjacent sides by at least: 0.06 um" ;
    RECT_ENC mcon_notcore m1_dg -good 0.06 0 0.06 0;
}

RULE CDR.m1.6 {
    CAPTION "CDR: min met1 area: 0.083 sq um";
    AREA m1_dg -lt 0.083;
}

RULE CDR.m1.7 {
    CAPTION "CDR: min area of met1 holes: 0.140 sq um";
    HOLES m1_dg -outputlayer m1.7_a;
    AREA m1.7_a -lt 0.14;
}
SELECT -inside via1 SEALID -outputlayer via1.insideSR;
NOT via1 via1.insideSR via1.outsideSR;
SELECT -inside via1 areaid.mt -outputlayer via1_mt;
NOT via1 via1_mt via1_not_mt;
NOT via1_not_mt via1.insideSR via1_neither;

RULE via1.3 {
    CAPTION "Only min. square vias are allowed except die seal ring where vias are (via1 CD)*L == 0.20 * L";
    CAPTION " this seal ring via1 does not have W = 0.2 um ";
    RECT_CHK -not via1.insideSR -eq 0.2;
}

RULE via1.1a {
    CAPTION "CDR: Min and max L and W of via1 outside areaid.mt == 0.15 um";
    RECT_CHK -not via1_neither -eq 0.15 -by -eq 0.15 -orthogonal_only;
}

RULE via1.1b {
    CAPTION "AL Flow - Three sizes of square Vias allowed inside areaid.mt: 0.15 um, 0.23 um and 0.28 um";
    RECT_CHK -not via1_mt -eq 0.15 -by -eq 0.15 -orthogonal_only -outputlayer via1.not15;
    RECT_CHK -not via1.not15 -eq 0.23 -by -eq 0.23 -orthogonal_only -outputlayer via1.not15_23;
    RECT_CHK -not via1.not15_23 -eq 0.28 -by -eq 0.28 -orthogonal_only;
}

RULE CDR.via1.2 {
    CAPTION "CDR: Min spacing of via1: 0.17 um";
    EXTE via1 -lt 0.17 -single_point -output region;
}

RULE CDR.via1.4a {
    CAPTION "CDR: via1 outside of areaid.mt must be enclosed by met1 by at least: 0.055 um";
    ENC via1_not_mt met1 -lt 0.055 -output region;
    EDGE_SELECT via1_not_mt met1;
}

RULE via1.4b {
    CAPTION "Inside areaid.mt, 0.23 um via1 must be enclosed by met1 by at least: 0.03 um";
    RECT_CHK via1_mt -eq 0.23 -orthogonal_only -outputlayer via1.4b_a;
    ENC via1.4b_a met1 -lt 0.03 -outside_also -output region;
}

RULE CDR.via1.5a {
    CAPTION "CDR: Min enclosure of 0.15 um via1 by met1 on one of two adjacent sides: 0.085 um";
    RECT_CHK via1 -eq 0.15 -orthogonal_only -outputlayer via1.5a_a;
    RECT_ENC via1.5a_a met1 -good 0.085 0 0.085 0;
}

RULE via1.5b {
    CAPTION "Min enclosure of 0.23 um via1 by met1 on one of two adjacent sides: 0.085 um";
    RECT_CHK via1 -eq 0.23 -orthogonal_only -outputlayer via1.5b_a;
    RECT_ENC via1.5b_a met1 -good 0.085 0 0.085 0;
}

RULE CDR.m2.1 {
    CAPTION "CDR: Min width of met2: 0.14 um";
    INTE m2_dg -lt 0.14 -output region;
}

RULE CDR.m2.2 {
    CAPTION "CDR: Min spacing/notch of met2: 0.14 um";
    EXTE m2_dg -lt 0.14 -single_point -output region;
}
NOT m2_dg huge_met2 met2_not_huge;
SIZE huge_met2 -by 0.28 -inside_of m2_dg -outputlayer huge_met2_028;
AND met2_not_huge huge_met2_028 met2_huge_and;
SELECT -touch met2_huge_and huge_met2 -outputlayer met2_touching_huge;

RULE CDRW.m2.3a {
    CAPTION "CDRW: Min spacing of huge met2 (width > 3.0 um) to narrow met2,";
    CAPTION "including features extending 0.28 um into narrow met2: 0.28 um";
    EXTE met2_touching_huge m2_dg -lt 0.28 -single_point -output region;
}

RULE CDRW.m2.3b {
    CAPTION "CDRW: Min spacing of huge_met2 to met2 excluding features checked by m2.3a: 0.28 um";
    EXTE huge_met2 m2_dg -lt 0.28 -single_point -output region;
}

RULE CDR.m2.4a {
    CAPTION "CDR: via1 outside areaid.ce must be enclosed by met2 by at least: 0.055 um";
    NOT via1 areaid.ce _EPTMPL262884;
    ENC CDR.m2.4a:_EPTMPL262884 m2_dg -lt 0.055 -output region;
    NOT via1 areaid.ce _EPTMPL262886;
    EDGE_SELECT CDR.m2.4a:_EPTMPL262886 m2_dg;
}

RULE CDR.m2.4b {
    CAPTION "CDR: via1 inside areaid.ce must be enclosed by met2 by at least: 0.045 um";
    AND via1 areaid.ce _EPTMPL262888;
    ENC CDR.m2.4b:_EPTMPL262888 met2 -lt 0.045 -output region;
    AND via1 areaid.ce _EPTMPL262890;
    EDGE_SELECT CDR.m2.4b:_EPTMPL262890 m2_dg;
}

RULE CDR.m2.5 {
    CAPTION "CDR: via1 outside areaid.ce must be enclosed by met2 on one of two adjacent sides by at least: 0.085 um" ;
    NOT via1 areaid.ce _EPTMPL262892;
    RECT_ENC CDR.m2.5:_EPTMPL262892 m2_dg -good 0.085 0 0.085 0;
}

RULE CDR.m2.6 {
    CAPTION "CDR: min met2 area: 0.067 sq um";
    AREA m2_dg -lt 0.067;
}

RULE CDR.m2.7 {
    CAPTION "CDR: min area of met2 holes: 0.140 sq um";
    HOLES m2_dg -outputlayer m2.7_a;
    AREA m2.7_a -lt 0.14;
}
SELECT -inside via2 SEALID -outputlayer via2.insideSR;
NOT via2 via2.insideSR via2.outsideSR;
SELECT -inside via2 areaid.mt -outputlayer via2.areaid.mt;
NOT via2 via2.areaid.mt -outputlayer via2.not_areaid.mt;
NOT via2.not_areaid.mt via2.insideSR via2_neither;

RULE CDR.via2.1a {
    CAPTION "CDR: Min and max L and W of via2 outside areaid.mt: 0.20 um";
    RECT_CHK -not via2_neither -eq 0.2 -by -eq 0.2 -orthogonal_only;
}

RULE via2.1d {
    CAPTION "Four sizes of square Via2s allowed inside areaid.mt: 0.200um, 0.280um, 1.200um and 1.500um";
    RECT_CHK -not via2.areaid.mt -eq 0.2 -by -eq 0.2 -orthogonal_only -outputlayer via2.1d_b;
    RECT_CHK -not via2.1d_b -eq 0.28 -by -eq 0.28 -orthogonal_only -outputlayer via2.1d_c;
    RECT_CHK -not via2.1d_c -eq 1.2 -by -eq 1.2 -orthogonal_only -outputlayer via2.1d_d;
    RECT_CHK -not via2.1d_d -eq 1.5 -by -eq 1.5 -orthogonal_only;
}

RULE CDR.via2.2 {
    CAPTION "CDR: Min spacing of via2: 0.20 um";
    EXTE via2 -lt 0.2 -single_point -output region;
}

RULE via2.3 {
    CAPTION "Only min. square via2s are allowed except die seal ring where vias are (via2 CD)*L == 0.20 * L";
    CAPTION " this seal ring via2 does not have W = 0.2 um";
    RECT_CHK -not via2.insideSR -eq 0.2;
}

RULE CDR.via2.4 {
    CAPTION "CDR: Min enclosure of via2 by met2: 0.04 um";
    ENC via2 met2 -lt 0.04 -output region;
    EDGE_SELECT via2 met2;
}

RULE via2.4a {
    CAPTION "Inside areaid.mt, Min enclosure of 1.5 um via2 by met2: 0.14 um";
    RECT_CHK via2.areaid.mt -eq 1.5 -orthogonal_only -outputlayer via2.4b_a;
    ENC via2.4b_a met2 -lt 0.14 -output region;
    EDGE_SELECT via2.4b_a met2;
}

RULE CDR.via2.5 {
    CAPTION "CDR: Min enclosure of via2 by met2 on one of two adjacent sides: 0.085 um";
    RECT_ENC via2 met2 -good 0.085 0 0.085 0;
}

RULE m3.1 {
    CAPTION "CDR: Min width of met3: 0.30 um";
    INTE m3_dg -lt 0.3 -output region;
}

RULE CDR.m3.2 {
    CAPTION "CDR: Min spacing/notch of met3: 0.30 um";
    EXTE m3_dg -lt 0.3 -single_point -output region;
}
NOT m3_dg huge_met3 met3_not_huge;
SIZE huge_met3 -by 0.28 -inside_of m3_dg -outputlayer huge_met3_040;
AND met3_not_huge huge_met3_040 met3_huge_and;
SELECT -touch met3_huge_and huge_met3 -outputlayer met3_touching_huge;

RULE CDRW.m3.3c {
    CAPTION "CDRW: Min spacing of huge met3 (width > 3.0 um) to narrow met3,";
    CAPTION "including features extending 0.28 um into narrow met3: 0.40 um";
    EXTE met3_touching_huge m3_dg -lt 0.4 -single_point -output region;
}

RULE CDRW.m3.3d {
    CAPTION "CDRW: Min spacing of huge_met3 to met3 excluding features checked by m3.3c: 0.40 um";
    EXTE huge_met3 m3_dg -lt 0.4 -single_point -output region;
}

RULE CDR.m3.4 {
    CAPTION "CDR: Min enclosure of via2 by met3: 0.065 um";
    ENC via2 m3_dg -lt 0.065 -output region;
    EDGE_SELECT -inside via2 m3_dg;
}

RULE CDR.m3.6 {
    CAPTION "CDR: min met3 area: 0.240 sq um";
    AREA m3_dg -lt 0.24;
}

RULE CDR.m3.7 {
    CAPTION "CDR: min area of met3 holes: 0.200 sq um";
    HOLES m3_dg -outputlayer m3.7_a;
    AREA m3.7_a -lt 0.2;
}
SELECT -inside via3 SEALID -outputlayer via3.insideSR;
NOT via3 via3.insideSR via3.outsideSR;
SELECT -inside via3 areaid.mt -outputlayer via3.areaid.mt;
NOT via3 via3.areaid.mt via3.not_areaid.mt;
NOT via3.not_areaid.mt via3.insideSR via3_neither;

RULE CDR.via3.1 {
    CAPTION "CDR: Min and max L and W of via3 (except for rule via3.1a) == 0.20 um";
    RECT_CHK -not via3_neither -eq 0.2 -by -eq 0.2 -orthogonal_only;
}

RULE via3.1a {
    CAPTION "Two sizes of square via3 allowed inside areaid.mt: 0.200um and 0.800um";
    RECT_CHK -not via3.areaid.mt -eq 0.2 -by -eq 0.2 -orthogonal_only -outputlayer via3.not0.2;
    RECT_CHK -not via3.not0.2 -eq 0.8 -by -eq 0.8 -orthogonal_only;
}

RULE CDR.via3.2 {
    CAPTION "CDR: Min spacing of via3: 0.20 um";
    EXTE via3 -lt 0.2 -single_point -output region;
}

RULE via3.3 {
    CAPTION "Only min. square via3s are allowed except die seal ring where via3s are (via3 CD)*L == 0.20 * L";
    CAPTION " this seal ring via3 does not have W = 0.2 um";
    RECT_CHK -not via3.insideSR -eq 0.2;
}

RULE CDR.via3.4 {
    CAPTION "CDR: Min enclosure of via3 by met3: 0.06 um";
    ENC via3 met3 -lt 0.06 -output region;
    EDGE_SELECT via3 met3;
}

RULE CDR.via3.5 {
    CAPTION "CDR: Min enclosure of via3 by 3et3 on one of two adjacent sides: 0.09 um";
    RECT_ENC via3 met3 -good 0.09 0 0.09 0;
}

RULE CDR.nsm.1 {
    CAPTION "CDR: Min width of nsm: 3.00 um";
    INTE nsm -lt 3 -single_point -output region;
}

RULE CDR.nsm.2 {
    CAPTION "CDR: Min spacing of nsm: 4.00 um";
    EXTE nsm nsm -lt 4 -single_point -output region;
}

RULE CDR.m4.1 {
    CAPTION "CDR: Min width of met4: 0.30 um";
    INTE m4_dg -lt 0.3 -output region;
}

RULE CDR.m4.2 {
    CAPTION "CDR: Min spacing/notch of met4: 0.30 um";
    EXTE m4_dg -lt 0.3 -single_point -output region;
}

RULE CDR.m4.3 {
    CAPTION "CDR: Min enclosure of via3 by met4: 0.065 um";
    ENC via3 m4_dg -lt 0.065 -output region;
    EDGE_SELECT -inside via3 m4_dg;
}

RULE CDR.m4.4a {
    CAPTION "CDR: Min met4 area: 0.240 sq um";
    AREA m4_dg -lt 0.24;
}
NOT m4_dg huge_met4 met4_not_huge;
SIZE huge_met4 -by 0.28 -inside_of m4_dg -outputlayer huge_met4_040;
AND met4_not_huge huge_met4_040 met4_huge_and;
SELECT -touch met4_huge_and huge_met4 -outputlayer met4_touching_huge;

RULE CDRW.m4.5a {
    CAPTION "CDRW: Min spacing of huge met4 (width > 3.0 um) to narrow met4,";
    CAPTION "including features extending 0.28 um into narrow met4: 0.40 um";
    CAPTION "(rule not checked over non-huge m4_dg features)";
    EXTE met4_touching_huge m4_dg -lt 0.4 -single_point -output region;
}

RULE CDRW.m4.5b {
    CAPTION "CDRW: Min spacing of huge_met4 to met4 excluding features checked by m4.3c: 0.40 um";
    EXTE huge_met4 m4_dg -lt 0.4 -single_point -output region;
}

RULE CDR.m4.7 {
    CAPTION "CDR: Min area of met4 holes: 0.200 sq um";
    HOLES met4 -outputlayer m4.7_a;
    AREA m4.7_a -lt 0.2;
}
SELECT -inside via4 SEALID -outputlayer via4.insideSR;
NOT via4 via4.insideSR via4.outsideSR;

RULE CDR.via4.1 {
    CAPTION "CDR: Min and max L and W of via4 == 0.80 um";
    RECT_CHK -not via4.outsideSR -eq 0.8 -by -eq 0.8 -orthogonal_only;
}

RULE CDR.via4.2 {
    CAPTION "CDR: Spacing of via4: 0.80 um";
    EXTE via4 -lt 0.8 -single_point -output region;
}

RULE via4.3 {
    CAPTION "Only min. square via4s are allowed except die seal ring where via4s are (via4 CD)*L == 0.80 * L";
    CAPTION " this seal ring via4 does not have W = 0.8 um";
    RECT_CHK -not via4.insideSR -eq 0.8;
}

RULE CDR.via4.4 {
    CAPTION "CDR: Min enclosure of via4 by met4: 0.19 um";
    ENC via4 met4 -lt 0.19 -output region;
    EDGE_SELECT via4 met4;
}

RULE CDR.m5.1 {
    CAPTION "CDR: Min width of met5: 1.60 um";
    INTE m5_dg -lt 1.6 -output region;
}

RULE CDR.m5.2 {
    CAPTION "CDR: Min spacing/notch of met5: 1.60 um";
    EXTE m5_dg -lt 1.6 -single_point -output region;
}

RULE CDR.m5.3 {
    CAPTION "CDR: Min enclosure of via4 by met5: 0.31 um";
    ENC via4 m5_dg -lt 0.31 -output region;
    EDGE_SELECT -inside via4 m5_dg;
}

RULE CDR.m5.4 {
    CAPTION "CDR: Min area of met5: 4.0 sq um";
    AREA m5_dg -lt 4;
}

RULE CDR.pad.2 {
    CAPTION "CDR: Min spacing of pad: 1.27 um";
    EXTE pad -lt 1.27 -single_point -output region;
}

RULE pad.3 {
    CAPTION "Min area of hugePad NOT top_metal: 30000 sq um";
    CAPTION " Adjust top_metal based on final process type";
    NOT hugePad met5 -outputlayer pad.3a;
    AREA pad.3a -lt 30000;
}

RULE hvi.nwell {
    CAPTION "hvi must not straddle nwell";
    EDGE_BOOLEAN -inside hvi nwell;
}

RULE hvi.1 {
    CAPTION "Min width of Hvi: 0.02 um";
    INTE hvi -lt 0.02 -single_point -output region;
}

RULE hvi.2 {
    CAPTION "Min spacing of Hvi to Hvi: 0.70 um";
    CAPTION "Manual merge if space is below minimum";
    EXTE hvi hvi -lt 0.7 -single_point -output region;
}

RULE hvi.4 {
    CAPTION "Hvi must not overlap tunm";
    AND hvi tunm;
}
OR hvi vhvi uhvi -outputlayer all_hvi;
SELECT -interact nwell uhvi -outputlayer nwell_uhvi;
STAMP nwell_uhvi nwell -outputlayer nwell_uhv;
NOT nwell nwell_uhv -outputlayer nw_not_uvh;
SELECT -interact nw_not_uvh vhvi -outputlayer nwell_vhvi;
STAMP nwell_vhvi nwell -outputlayer nwell_vhv;
OR nwell_uhv nwell_vhv _EPTMPL262981;
NOT nwell _EPTMPL262981 -outputlayer nw_not_vhv_or_uhv;
SELECT -interact nw_not_vhv_or_uhv hvi -outputlayer nwell_hvi;
STAMP nwell_hvi nwell -outputlayer nwell_hv;
SELECT -interact -not nwell all_hvi -outputlayer nwell_lvi;
STAMP nwell_lvi nwell -outputlayer nwell_lv;

RULE hvnwell.8.hv {
    CAPTION "Min space/notch of HV_nwell: 1.27";
    EXTE nwell_hv -lt 1.27 -abut -lt 90 -single_point -output region;
}

RULE hvnwell.8.hv_vhv {
    CAPTION "Min space of HV_nwell to VHV_nwell: 2.0";
    EXTE nwell_hv nwell_vhv -lt 2 -abut -lt 90 -single_point -output region;
}

RULE hvnwell.8.hv_uhv {
    CAPTION "Min space of HV_nwell to UHV_nwell: 2.5";
    EXTE nwell_hv nwell_uhv -lt 2.5 -abut -lt 90 -single_point -output region;
}

RULE hvnwell.8.vhv {
    CAPTION "Min space/notch of VHV_nwell: 2.0";
    EXTE nwell_vhv -lt 2 -abut -lt 90 -single_point -output region;
}

RULE hvnwell.8.vhv_uhv {
    CAPTION "Min space of VHV_nwell to UHV_nwell: 2.5";
    EXTE nwell_vhv nwell_uhv -lt 2.5 -abut -lt 90 -single_point -output region;
}

RULE hvnwell.8.uvh {
    CAPTION "Min space/notch of UHV_nwell: 2.5";
    EXTE nwell_uhv -lt 2.5 -abut -lt 90 -single_point -output region;
}
SELECT -cut nwell hvi -outputlayer nwell_ovlp_hvi;

RULE hvnwell.9 {
    CAPTION "(Nwell overlapping hvi) must be enclosed by hvi";
    NOT nwell_ovlp_hvi hvi;
}

RULE hvdifftap.14 {
    CAPTION "Min width of diff (not tap) inside hvi, except HV pdiff resistors (hvdifftap.14a): 0.29 um";
    AND diff hvi -outputlayer hvdiff;
    SELECT -interact -not hvdiff diff_res _EPTMPL262996;
    INTE hvdifftap.14:_EPTMPL262996 -lt 0.29 -single_point -output region;
}

RULE hvdifftap.14a {
    CAPTION "Min width of diff inside hvi, HV pdiff resistors only: 0.15 um";
    AND diff diff_res _EPTMPL262998;
    AND hvdifftap.14a:_EPTMPL262998 hvi -outputlayer hvdiff;
    INTE hvdiff -lt 0.15 -single_point -output region;
}

RULE hvdifftap.15a {
    CAPTION "Min space of diff inside hvi: 0.30 um";
    EXTE hdiff hdiff -lt 0.3 -single_point -output region;
}

RULE hvdifftap.15b {
    CAPTION "Min space of ndiff to non-abutting ptap inside hvi: 0.37 um";
    AND ptap hvi -outputlayer hvdifftap.15b_a;
    AND ndiff hvi -outputlayer hvdifftap.15b_b;
    EXTE hvdifftap.15b_a hvdifftap.15b_b -lt 0.37 -single_point -output region;
}

RULE hvdifftap.16 {
    CAPTION "Min width tap butting diff on one or two sides inside hvi: 0.70 um";
    CAPTION " Rule exempted inside UHVI";
    SELECT -touch htap hdiff -ltgt 0 3 -outputlayer hvdifftap.16_a;
    NOT hvdifftap.16_a uhvi -outputlayer hvdifftap.16_b;
    INTE hvdifftap.16_b -lt 0.7 -single_point -output region;
}

RULE hvdifftap.17 {
    CAPTION "Min enclosure of HV pdiff or pdiff inside areaid:hvnwell by HV nwell: 0.33 um";
    CAPTION "  Rule exempted inside UHVI ";
    SELECT -outside -not pdiff areaid.hl -outputlayer hvdifftap.17_a;
    ENC hvdifftap.17_a hv_nwell -lt 0.33 -output region;
}

RULE hvdifftap.18 {
    CAPTION "Min spacing of N+ diff to HV nwell (rule exempted inside UHVI): 0.43 um";
    NOT ndiff uhvi -outputlayer hvdifftap.18_a;
    EXTE hvdifftap.18_a hv_nwell -lt 0.43 -single_point -output region;
}

RULE hvdifftap.19 {
    CAPTION "Min enclosure of HV ntap by HV nwell: 0.33 um";
    CAPTION "  Rule exempted inside UHVI ";
    NOT htap uhvi -outputlayer hvdifftap.19_a;
    ENC hvdifftap.19_a hv_nwell -lt 0.33 -output region;
}

RULE hvdifftap.20 {
    CAPTION "Spacing of P+ tap to HV nwell (Exempted for ptap butting pwell.rs, rule exempted inside UHVI): 0.43 um";
    NOT ptap uhvi -outputlayer hvdifftap.20_a;
    EXTE hvdifftap.20_a hv_nwell -lt 0.43 -output region;
}

RULE hvdifftap.21 {
    CAPTION "Diff or tap cannot straddle hvi";
    SELECT -cut diff hvi;
    SELECT -cut tap hvi;
}

RULE hvdifftap.22 {
    CAPTION "Min enclosure of Hdiff or Htap by hvi. Rule exempted inside UHVI: 0.18 um ";
    NOT hdiff uhvi -outputlayer hvdifftap.22_a;
    NOT htap uhvi -outputlayer hvdifftap.22_b;
    ENC hvdifftap.22_a hvi -lt 0.18 -output region;
    ENC hvdifftap.22_b hvi -lt 0.18 -output region;
}

RULE hvdifftap.24 {
    CAPTION "Min spacing of nwell to HV ndiff (rule exempted inside UHVI): 0.43 um";
    NOT nwell uhvi -outputlayer hvdifftap.24_a;
    EXTE hvdifftap.24_a hdiff -lt 0.43 -output region;
}

RULE CDR.hvdifftap.25 {
    CAPTION "CDR: Min space of N+ Hdiff inside HVI across non-abutting P+_tap: 1.07 um";
    NOT hdiff hvi -outputlayer hvdifftap.25_a;
    EXTE hvdifftap.25_a ptap -lt 0.107 -output region;
}
SELECT -inside poly hvi -outputlayer hvpoly.13_a;
SELECT -cut hvpoly.13_a diff -outputlayer hvpoly.13_b;
EDGE_BOOLEAN -coincident_only hvpoly.13_b gate_a -outputlayer poly_edges;

RULE hvpoly.13 {
    CAPTION "Min width of poly over diff inside hvi: 0.50 um" ;
    INTE poly_edges -lt 0.5 -metric opposite -para ONLY -output region;
}

RULE hvpoly.14 {
    CAPTION "(poly and diff) cannot straddle hvi";
    SELECT -cut gate hvi;
}

RULE CDR.hvntm.1 {
    CAPTION "CDR: Min width of hvntm: 0.70 um";
    INTE hvntm -lt 0.7 -single_point -output region;
}

RULE hvntm.2 {
    CAPTION "Spacing of hvntm to hvntm: 0.70 um";
    EXTE hvntm hvntm -lt 0.7 -single_point -output region;
}

RULE hvntm.3 {
    CAPTION "Min enclosure of (ndiff inside hvi) but not overlapping areaid.ce by hvntm: 0.185 um";
    SELECT -inside ndiff hvi -outputlayer hvntm.3_a;
    NOT hvntm.3_a areaid.ce hvntm.3_b;
    ENC hvntm.3_b hvntm -lt 0.185 -output region;
}

RULE hvntm.4 {
    CAPTION "Min space between (ndiff outside hvi) and hvntm: 0.185 um";
    CAPTION " No overlap allowed "	;
    SELECT -outside ndiff hvi -outputlayer hvntm.4_a;
    EXTE hvntm.4_a hvntm -lt 0.185 -single_point -output region;
    NOT ndiff hvi _EPTMPL263038;
    AND hvntm.4:_EPTMPL263038 hvntm;
}

RULE hvntm.5 {
    CAPTION "Min space between pdiff and hvntm: 0.185 um";
    CAPTION " No overlap allowed "	;
    EXTE pdiff hvntm -lt 0.185 -overlap -single_point -output region;
}

RULE hvntm.6a {
    CAPTION "Min space between ptap and hvntm (except along the diff-butting edge): 0.185 um";
    CAPTION " No overlap allowed "	;
    EXTE ptap hvntm -lt 0.185 -overlap -single_point -output region;
}

RULE hvntm.6b {
    CAPTION "Min space between ptap and hvntm along the diff-butting edge: 0.00 um";
    CAPTION " No overlap allowed "	;
    SELECT -touch ptap hvntm -outputlayer hvntm.6b_a;
    EXTE hvntm.6b_a ptap -eq 0 -output region;
}

RULE hvntm.9 {
    CAPTION "hvntm must not overlap areaid.ce";
    AND hvntm areaid.ce;
}

RULE hvntm.10 {
    CAPTION "hvntm must overlap hvi (v5)" ;
    NOT hvntm hvi;
}
NOT areaid.en dnwell areaid.de_nFet;
AND diff areaid.de_nFet -outputlayer de_nFet_SD;
SELECT -interact -not de_nFet_SD poly -outputlayer isolated_ntap;
AND poly areaid.de_nFet -outputlayer deFET_gate_pvsTmp1;
SELECT -inside -not deFET_gate_pvsTmp1 pwde -outputlayer deFET_gate;
NOT diff dnwell -outputlayer de_nFet_gate_pvsTmp1;
SELECT -cut deFET_gate de_nFet_gate_pvsTmp1 -outputlayer de_nFet_gate;
SELECT -cut de_nFet_SD de_nFet_gate -outputlayer de_nFet_source;
AND isolated_ntap areaid.de_nFet -outputlayer de_nFet_drain_pvsTmp1;
SELECT -inside de_nFet_drain_pvsTmp1 nwell -outputlayer de_nFet_drain;

RULE denmos.1 {
    CAPTION "Min width of de_nFet_gate: 1.055 um" ;
    INTE de_nFet_gate -lt 1.055 -single_point -output region;
}
NOT de_nFet_source poly -outputlayer de_nFet_source_not_poly;
AND de_nFet_source poly -outputlayer de_nFet_source_and_poly;

RULE denmos.2 {
    CAPTION "Min width of de_nFet_source not overlapping poly: 0.28 um";
    INTE de_nFet_source_not_poly -lt 0.28 -single_point -output region;
}

RULE denmos.3 {
    CAPTION "Min width of de_nFet_source overlapping poly: 0.925 um";
    INTE de_nFet_source_and_poly -lt 0.925 -single_point -output region;
}
ANGLE -not de_nFet_drain -ltgt 0 90 -outputlayer de_nFet_drain_ortho;
EDGE_LENGTH de_nFet_drain_ortho -lt 0.17 -outputlayer de_nFet_drain_bad;

RULE denmos.4 {
    CAPTION "Min width of the de_nFet_drain: 0.17 um";
    COPY de_nFet_drain_bad;
}
AND de_nFet_source nwell -outputlayer de_nFet_source_nwell;

RULE denmos.5 {
    CAPTION "Min/Max extension of de_nFet_source over nwell == 0.225";
    WITH_WIDTH -not de_nFet_source_nwell -eq 0.225;
}
EXTE de_nFet_drain de_nFet_source -eq 1.585 -single_point -parallel only -metric opposite -output region -outputlayer de_nFet_good_region;
SELECT -touch -not de_nFet_source de_nFet_good_region -outputlayer de_nFet_source_bad;

RULE denmos.6 {
    CAPTION "Min/Max spacing between de_nFet_drain and de_nFet_source == 1.585 um";
    EXTE de_nFet_drain de_nFet_source_bad -lt 3 -parallel only -metric opposite -output region;
}
EDGE_BOOLEAN -inside de_nFet_gate diff -outputlayer denmos_width;

RULE denmos.7 {
    CAPTION "Min channel width for de_nFet_gate: 5.00 um";
    EDGE_LENGTH denmos_width -lt 5;
}
SELECT -enclose nwell de_nFET_drain -outputlayer denmos.8_nwell;

RULE denmos.8 {
    CAPTION "90 degree angles are not permitted for nwell overlapping de_nFET_drain";
    VERTEX denmos.8_nwell -lt 8;
}
ENC ntap nwell_ovlp_de_nFET_Drain -lt 0.66 -output region -outputlayer denmos.10.region;
SELECT -interact -not denmos.10.region de_nFet_source -outputlayer denmos.10.bad;

RULE denmos.10 {
    CAPTION "Min enclosure of de_nFet_drain by nwell: 0.66 um";
    COPY denmos.10.bad;
}
SELECT -cut nwell de_nFET_drain -outputlayer nwell_ovlp_de_nFET_Drain;

RULE denmos.11 {
    CAPTION "Min spacing between p+ tap and (nwell overlapping de_nFet_drain): 0.86 um";
    EXTE ptap_actual nwell_ovlp_de_nFET_Drain -lt 0.86 -single_point -output region;
}

RULE denmos.12 {
    CAPTION "Min spacing between nwells overlapping de_nFET_drain: 2.40 um";
    EXTE nwell_ovlp_de_nFET_Drain -lt 2.4 -single_point -output region;
}

RULE denmos.13 {
    CAPTION "de_nFet_source must be enclosed by nsdm by: 0.13 um";
    ENC de_nFet_source nsdm -lt 0.13 -output region;
}
AND areaid.en dnwell areaid.de_pFet;
AND diff areaid.de_pFet -outputlayer de_pFet_SD;
SELECT -interact -not de_pFet_SD poly -outputlayer isolated_ptap;
AND isolated_ptap areaid.de_pFet -outputlayer de_pFet_drain_pvsTmp1;
SELECT -inside -not de_pFet_drain_pvsTmp1 nwell -outputlayer de_pFet_drain;
NOT de_pFet_SD de_pFet_drain de_pFet_source;
SELECT -cut poly de_pFet_SD -outputlayer de_pFet_gate;

RULE depmos.1 {
    CAPTION "Min width of de_pFet_gate: 1.05 um" ;
    INTE de_pFet_gate -lt 1.05 -single_point -output region;
}
NOT de_pFet_source poly -outputlayer de_pFet_source_not_poly;
AND de_pFet_source poly -outputlayer de_pFet_source_and_poly;

RULE depmos.2 {
    CAPTION "Min width of de_pFet_source not overlapping poly: 0.28 um";
    INTE de_pFet_source_not_poly -lt 0.28 -single_point -output region;
}

RULE depmos.3 {
    CAPTION "Min width of de_pFet_source overlapping poly: 0.92 um";
    INTE de_pFet_source_and_poly -lt 0.92 -single_point -output region;
}
ANGLE -not de_pFet_drain -ltgt 0 90 -outputlayer de_pFet_drain_ortho;
EDGE_LENGTH de_pFet_drain_ortho -lt 0.17 -outputlayer de_pFet_drain_bad;

RULE depmos.4 {
    CAPTION "Min width of the de_pFet_drain: 0.17 um";
    COPY de_pFet_drain_bad;
}
SELECT -cut de_pFet_source nwell -outputlayer de_pFet_source_w_nwell;
NOT de_pFet_source_w_nwell nwell -outputlayer de_pFet_source_not_nwell;

RULE depmos.5 {
    CAPTION "Min/Max extension of de_pFet_source beyond nwell == 0.260";
    WITH_WIDTH de_pFet_source_not_nwell -ne 0.26;
}
EXTE de_pFet_drain de_pFet_source -eq 1.19 -single_point -parallel only -metric opposite -output region -outputlayer de_pFet_good_region;
SELECT -touch -not de_pFet_source de_pFet_good_region -outputlayer de_pFet_source_bad;

RULE depmos.6 {
    CAPTION "Min/Max spacing between de_pFet_drain and de_pFet_source == 1.19 um";
    EXTE de_pFet_drain de_pFet_source_bad -lt 2 -parallel only -metric opposite -output region;
}
EDGE_BOOLEAN -inside de_pFet_gate diff -outputlayer depmos_width;

RULE depmos.7 {
    CAPTION "Min channel width for de_pFet_gate: 5.00 um";
    EDGE_LENGTH depmos_width -lt 5;
}
HOLES nwell -outputlayer nwell_holes;
SELECT -enclose nwell_holes de_pFET_drain -outputlayer depmos.8_nwell;

RULE depmos.8 {
    CAPTION "90 degree angles are not permitted for nwell overlapping de_pFET_drain";
    VERTEX depmos.8_nwell -lt 8;
}

RULE depmos.10 {
    CAPTION "Min enclosure of de_pFet_drain by nwell hole: 0.86 um";
    ENC de_pFet_drain nwell_holes -lt 0.86 -output region;
}
SELECT -enclose nwell_holes de_pFET_drain -outputlayer nwell_enc_de_pFET_Drain;

RULE depmos.11 {
    CAPTION "Min spacing between n+ tap and (nwell hole enclosing de_pFet_drain): 0.66 um";
    EXTE ntap_actual nwell_enc_de_pFET_Drain -lt 0.66 -single_point -output region;
}

RULE depmos.12 {
    CAPTION "Min enclosure of de_pFet_source by psdm: 0.13 um";
    ENC de_pFet_source psdm -lt 0.13 -output region;
}

RULE vhvi.uhvi {
    CAPTION "vhvi must not overlap uhvi";
    AND vhvi uhvi;
}

RULE vhvi.1 {
    CAPTION "Min width of vhvi:dg: 0.02 um";
    INTE vhvi -lt 0.02 -single_point -output region;
}

RULE vhvi.2 {
    CAPTION "Vhvi:dg cannot overlap areaid:ce";
    AND vhvi areaid.ce;
}

RULE vhvi.3 {
    CAPTION "VHVGate must overlap hvi:dg"	;
    SELECT -interact -not VHVGate hvi;
}

RULE vhvi.5 {
    CAPTION "Vhvi:dg cannot straddle VHVSourceDrain";
    SELECT -cut vhvi VHVSourceDrain;
}

RULE vhvi.6 {
    CAPTION "Vhvi:dg overlapping VHVSourceDrain must not overlap poly"	;
    SELECT -interact -not vhvi VHVSourceDrain -outputlayer vhvi.6_a;
    AND vhvi.6_a poly;
}

RULE vhvi.7 {
    CAPTION "Vhvi:dg cannot straddle VHVPoly";
    SELECT -cut vhvi VHVPoly;
}

RULE uhvi.1 {
    CAPTION "diff/tap cannot straddle UHVI";
    SELECT -cut diff uhvi;
}

RULE uhvi.2 {
    CAPTION "poly cannot straddle UHVI";
    SELECT -cut poly uhvi;
}
NOT pwbm lv_net pwbm_not_LV;

RULE uhvi.3 {
    CAPTION "pwbm must be enclosed by UHVI (exempt inside areaid:lvnet)";
    SELECT -inside -not pwbm_not_LV uhvi;
}

RULE uhvi.4 {
    CAPTION "dnwell cannot straddle UHVI";
    SELECT -cut dnwell uhvi;
}

RULE pwres.3 {
    CAPTION "Min length of pwell resistor: 26.50 um";
    RECT_CHK -not pwell_res -eq 2.65 -by -lege 26.5 265;
}

RULE pwres.5 {
    CAPTION "Min/Max spacing of tap inside the pwell resistor to nwell == 0.22 um";
    SELECT -inside tap pwell_res -outputlayer pwres.5_a;
    EXTE pwres.5_a nwell -lt 0.22 -single_point -output region;
}

RULE pwres.6 {
    CAPTION "Min/Max width of tap inside the pwell resistor == 0.53 um";
    SELECT -inside tap pwell_res -outputlayer pwres.6_a;
    WITH_WIDTH pwres.6_a -ne 0.53;
}

RULE pwres.7a {
    CAPTION "Every pwres_terminal must enclose 12 licon";
    SELECT -enclose -not pwell_terminal licon -eq 12;
}

RULE pwres.7b {
    CAPTION "Every pwres_terminal must enclose 12 mcons if routed through metal1";
    SELECT -inside licon pwell_terminal -outputlayer licon_in_term;
    SELECT -enclose li1 licon_in_term -outputlayer li1_with_licon_in_term;
    SELECT -enclose li1_with_licon_in_term mcon -outputlayer li1_con_met1_in_term;
    SELECT -inside li1_con_met1_in_term met1 -outputlayer term_con_met1;
    SELECT -enclose -not pwell_terminal mcon -eq 12;
}

RULE pwres.8 {
    CAPTION "Diff or poly is not allowed in the pwell resistor.";
    AND diff pwell_res;
    AND poly pwell_res;
}
OR sealid_hole SEALID -outputlayer chip_plus_sealhole;
SELECT -interact -not ALL SEALID _EPTMPL263137;
OR chip_plus_sealhole _EPTMPL263137 -outputlayer fill_extent;
NOT fill_extent SEALID -outputlayer fill_extent_not_SEALID;
OR diff_in diff_fill diff_mask -outputlayer diff_layers;
OR poly_dg poly_fill poly_mask -outputlayer poly_layers;
OR li_dg li_fill li_mask -outputlayer li_layers;
OR m1_dg m1_fill m1_mask -outputlayer m1_layers;
OR m2_dg m2_fill m2_mask -outputlayer m2_layers;
OR m3_dg m3_fill m3_mask -outputlayer m3_layers;
OR m4_dg m4_fill m4_mask -outputlayer m4_layers;
OR m5_dg m5_fill m5_mask -outputlayer m5_layers;

RULE CDR.diff.local.low {
    CAPTION "CDR: Min diff local density (700 square um window, 7 um step): 28%";
    CAPTION "  rdb file: diff_low_density.rdb";
    DENSITY diff_layers -lt 0.28 -window 700 -step 70 -inside_of layer fill_extent_not_SEALID -rdb diff_low_density.rdb;
}

RULE CDRW.diff.local.high {
    CAPTION "CDRW: Max diff local density (700 square um window, 7 um step): 62%";
    CAPTION "  rdb file: diff_high_density.rdb";
    DENSITY diff_layers -gt 0.62 -window 700 -step 70 -inside_of layer fill_extent_not_SEALID -rdb diff_high_density.rdb;
}

