module gate_driver(SAMPLE, VREF, SEL_VIN, SEL_VIN_N, SEL_VREF_P,
     SEL_VREF_P_N, SEL_VREF_N, SEL_VREF_N_N);
  input SAMPLE, VREF;
  output SEL_VIN, SEL_VIN_N, SEL_VREF_P, SEL_VREF_P_N, SEL_VREF_N,
       SEL_VREF_N_N;
  wire SAMPLE, VREF;
