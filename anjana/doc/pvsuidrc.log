    CAPTION "Min enclosure, with no overlap, of diff fill by FRAME (areaid.fe): 0.5 um";
    CAPTION " diff fill straddling FRAME not allowed ";
    ENC diff_fill areaid.fe -lt 0.5 -output region;
    EDGE_SELECT -inside diff_fill areaid.fe;
    SELECT -cut diff_fill areaid.fe;
}

