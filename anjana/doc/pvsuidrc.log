SELECT -outside pad areaid.ft -outputlayer bondPad;
AND capm met2 -outputlayer bottom_plate_pvsTmp1;
SIZE bottom_plate_pvsTmp1 -by 3 -outputlayer bottom_plate;
SELECT -enclose capm via2 -gt 1 -outputlayer capacitor;
SELECT -cut -not capm via2 -outputlayer dummy_capacitor;
SELECT -label "poly" -textname "dummy_poly" -textlayer text -outputlayer dummy_poly;
HOLES SEALID -outputlayer Chip_extent_pvsTmp1;
OR Chip_extent_pvsTmp1 SEALID -outputlayer Chip_extent;
OR diff_mask poly_mask m1_mask m2_mask -outputlayer Diecut_pmm_pvsTmp1;
NOT areaid.dt Diecut_pmm_pvsTmp1 -outputlayer Diecut_pmm;
WITH_WIDTH met1 -gt 3 -outputlayer huge_met1;
WITH_WIDTH met2 -gt 3 -outputlayer huge_met2;
WITH_WIDTH met3 -gt 3 -outputlayer huge_met3;
WITH_WIDTH met4 -gt 3 -outputlayer huge_met4;
WITH_WIDTH met5 -gt 3 -outputlayer huge_met5;
WITH_WIDTH pad -gt 100 -outputlayer hugePad;
EXTENT_DRAWN -original -outputlayer ALL;
NOT ALL SEALID -outputlayer ALL_not_sealid;
SELECT -cut -not ALL SEALID -outputlayer ALL_outside_sealid;
HOLES SEALID -inner -empty -outputlayer sealid_hole;
OR sealid_hole ALL_outside_sealid -outputlayer fill_area;
OR nwell localSub _EPTMPL262173;
NOT Chip_extent _EPTMPL262173 -outputlayer pwell;
SELECT -touch ptap pwell_res -outputlayer pwell_terminal;
AND pwell dnwell -outputlayer iso_pwell;
AND poly diff -outputlayer gate_a;
SELECT -donut -not gate_a -outputlayer gate;
NOT gate nwell -outputlayer nfet;
AND gate nwell -outputlayer pfet;
SELECT -inside gate lvtn -outputlayer LVTN_Gate;
OR diff_dg tap_dg diff_in;
AND diff_in nsdm diff_and_nsdm;
AND diff_in psdm diff_and_psdm;
NOT diff_and_nsdm nwell ndiff;
AND diff_and_psdm nwell pdiff;
AND diff_and_nsdm nwell _EPTMPL262187;
NOT _EPTMPL262187 poly ntap;
NOT diff_and_psdm nwell _EPTMPL262189;
NOT poly npn _EPTMPL262190;
NOT _EPTMPL262189 _EPTMPL262190 ptap;
OR ntap ptap tap;
NOT diff_in tap diff;
NOT diff_and_nsdm diff_res _EPTMPL262194;
NOT _EPTMPL262194 poly _EPTMPL262195;
NOT _EPTMPL262195 ntap nsd;
NOT diff_and_psdm diff_res _EPTMPL262197;
NOT _EPTMPL262197 poly _EPTMPL262198;
NOT _EPTMPL262198 ptap psd;
AND diff hvi -outputlayer hdiff;
AND tap licon -outputlayer tap_licon;
NOT tap poly -outputlayer tap_notPoly;
SELECT -inside tap nwell -outputlayer tap_nwell;
NOT nwell hvi -outputlayer Var_channel_pvsTmp1;
AND poly tap -outputlayer Var_channel_pvsTmp2;
AND Var_channel_pvsTmp2 Var_channel_pvsTmp1 -outputlayer Var_channel_pvsTmp3;
NOT Var_channel_pvsTmp3 areaid.ce -outputlayer Var_channel;
SELECT -cut tap Var_channel -outputlayer VaracTap;
SELECT -enclose met4 met4_fuse -outputlayer fuse;
NOT fuse met4_fuse -outputlayer fuse_contact;
SELECT -enclose -not met4 via3 -outputlayer fuse_shield_a;
SELECT -enclose -not fuse_shield_a via4 fuse_shield_b;
RECT_CHK fuse_shield_b -eq 0.5 -by -eq 2.4 -outputlayer fuse_shield;
OR rpm urpm -outputlayer rpm_urpm;
AND rpm_urpm psdm _EPTMPL262215;
AND poly_res _EPTMPL262215 _EPTMPL262216;
AND poly _EPTMPL262216 -outputlayer prec_resistor;
SELECT -enclose poly prec_resistor -outputlayer poly_prec_resistor;
AND nwell hvi -outputlayer nhvi;
SELECT -inside nwell areaid.hl -outputlayer nhl;
OR nhvi nhl -outputlayer hv_nwell;
AND tap hvi -outputlayer htap;
SELECT -inside poly vhvi -outputlayer VHVPoly;
AND VHVPoly diff -outputlayer VHVGate;
AND diff tap -outputlayer dtap;
AND dtap vhvi -outputlayer dhvi;
NOT dhvi poly -outputlayer dpoly;
NOT dpoly diff_res -outputlayer VHVSourceDrain;
SELECT -donut SEALID -outputlayer sealring_donut;
SELECT -donut diff -outputlayer sealring_diff;
SELECT -donut nsm -outputlayer sealring_nsm;
SELECT -enclose sealring_donut sealring_diff _EPTMPL262232;
SELECT -enclose sealring_donut sealring_nsm _EPTMPL262233;
SELECT -enclose _EPTMPL262232 _EPTMPL262233 -outputlayer sealring;
CONNECT nwell dnwell;
CONNECT ntap nwell;
CONNECT ptap pwell;
CONNECT li1 nsd -by licon;
CONNECT li1 psd -by licon;
CONNECT li1 ntap -by licon;
CONNECT li1 ptap -by licon;
CONNECT li1 poly -by licon;
CONNECT met1 li1 -by mcon;
CONNECT met2 met1 -by via1;
CONNECT met3 met2 -by via2;
CONNECT met4 met3 -by via3;
CONNECT met5 met4 -by via4;

RULE x.1b {
    CAPTION "Data for SKY130 layout and mask on all layers;
    CAPTION "except those mentioned in 1a must be on a grid;
    CAPTION "of 0.005 um (except inside Seal ring)";
    CAPTION "	NOTE: Seal ring not currently excluded";
    OFFGRID nwell 5;
